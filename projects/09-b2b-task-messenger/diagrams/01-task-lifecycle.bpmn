<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_task_lifecycle"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="portfolio/tools/bpmn_gen.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_task_lifecycle">
    <bpmn:participant id="Participant_task_lifecycle" name="Постановка, выполнение и оценка задачи" processRef="Process_task_lifecycle" />
  </bpmn:collaboration>
  <bpmn:process id="Process_task_lifecycle" name="Жизненный цикл клиентской задачи" isExecutable="false">
    <bpmn:documentation>Клиент ставит задачу привычным способом — в мессенджере, сотрудник работает в веб-интерфейсе, а состояние задачи синхронизируется с CRM.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_task_lifecycle">
      <bpmn:lane id="Lane_cli" name="Клиент">
        <bpmn:flowNodeRef>Start_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bot" name="Telegram-бот">
        <bpmn:flowNodeRef>T_parse</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_msg" name="Веб-мессенджер">
        <bpmn:flowNodeRef>T_chat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_escalate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_emp" name="Сотрудник">
        <bpmn:flowNodeRef>T_take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_rework</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_rework</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_crm" name="CRM">
        <bpmn:flowNodeRef>T_deal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_close</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Start_task" name="Клиент ставит задачу
в мессенджере">
        <bpmn:outgoing>Flow_01</bpmn:outgoing>
        <bpmn:messageEventDefinition />
      </bpmn:startEvent>
      <bpmn:serviceTask id="T_parse" name="Разобрать заявку
и определить тип">
        <bpmn:incoming>Flow_01</bpmn:incoming>
        <bpmn:outgoing>Flow_02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_chat" name="Создать чат задачи
и подключить участников">
        <bpmn:incoming>Flow_02</bpmn:incoming>
        <bpmn:outgoing>Flow_03</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_deal" name="Создать сделку">
        <bpmn:incoming>Flow_03</bpmn:incoming>
        <bpmn:outgoing>Flow_04</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_assign" name="Назначить
ответственного">
        <bpmn:incoming>Flow_04</bpmn:incoming>
        <bpmn:outgoing>Flow_05</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="T_take" name="Принять задачу
в работу">
        <bpmn:incoming>Flow_05</bpmn:incoming>
        <bpmn:outgoing>Flow_06</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_timer" name="Запустить таймер
по нормативу">
        <bpmn:incoming>Flow_06</bpmn:incoming>
        <bpmn:outgoing>Flow_07</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="T_work" name="Выполнить задачу
и приложить результат">
        <bpmn:incoming>Flow_07</bpmn:incoming>
        <bpmn:outgoing>Flow_08</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_sla" name="Уложились
в норматив?">
        <bpmn:incoming>Flow_08</bpmn:incoming>
        <bpmn:outgoing>Flow_09</bpmn:outgoing>
        <bpmn:outgoing>Flow_10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="T_escalate" name="Эскалировать
руководителю">
        <bpmn:incoming>Flow_10</bpmn:incoming>
        <bpmn:outgoing>Flow_11</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="T_review" name="Проверить результат">
        <bpmn:incoming>Flow_09</bpmn:incoming>
        <bpmn:incoming>Flow_11</bpmn:incoming>
        <bpmn:outgoing>Flow_12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_accept" name="Результат принят?">
        <bpmn:incoming>Flow_12</bpmn:incoming>
        <bpmn:outgoing>Flow_13</bpmn:outgoing>
        <bpmn:outgoing>Flow_14</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="T_rework" name="Вернуть задачу
в работу">
        <bpmn:incoming>Flow_14</bpmn:incoming>
        <bpmn:outgoing>Flow_15</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="End_rework" name="Задача
на доработке">
        <bpmn:incoming>Flow_15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="T_rate" name="Оценить работу
сотрудника">
        <bpmn:incoming>Flow_13</bpmn:incoming>
        <bpmn:outgoing>Flow_16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_close" name="Закрыть сделку
и записать оценку">
        <bpmn:incoming>Flow_16</bpmn:incoming>
        <bpmn:outgoing>Flow_17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_done" name="Задача закрыта">
        <bpmn:incoming>Flow_17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_task" targetRef="T_parse" />
      <bpmn:sequenceFlow id="Flow_02" sourceRef="T_parse" targetRef="T_chat" />
      <bpmn:sequenceFlow id="Flow_03" sourceRef="T_chat" targetRef="T_deal" />
      <bpmn:sequenceFlow id="Flow_04" sourceRef="T_deal" targetRef="T_assign" />
      <bpmn:sequenceFlow id="Flow_05" sourceRef="T_assign" targetRef="T_take" />
      <bpmn:sequenceFlow id="Flow_06" sourceRef="T_take" targetRef="T_timer" />
      <bpmn:sequenceFlow id="Flow_07" sourceRef="T_timer" targetRef="T_work" />
      <bpmn:sequenceFlow id="Flow_08" sourceRef="T_work" targetRef="G_sla" />
      <bpmn:sequenceFlow id="Flow_09" name="да" sourceRef="G_sla" targetRef="T_review" />
      <bpmn:sequenceFlow id="Flow_10" name="нет" sourceRef="G_sla" targetRef="T_escalate" />
      <bpmn:sequenceFlow id="Flow_11" sourceRef="T_escalate" targetRef="T_review" />
      <bpmn:sequenceFlow id="Flow_12" sourceRef="T_review" targetRef="G_accept" />
      <bpmn:sequenceFlow id="Flow_13" name="да" sourceRef="G_accept" targetRef="T_rate" />
      <bpmn:sequenceFlow id="Flow_14" name="нет" sourceRef="G_accept" targetRef="T_rework" />
      <bpmn:sequenceFlow id="Flow_15" sourceRef="T_rework" targetRef="End_rework" />
      <bpmn:sequenceFlow id="Flow_16" sourceRef="T_rate" targetRef="T_close" />
      <bpmn:sequenceFlow id="Flow_17" sourceRef="T_close" targetRef="End_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_task_lifecycle">
    <bpmndi:BPMNPlane id="Plane_task_lifecycle" bpmnElement="Collaboration_task_lifecycle">
      <bpmndi:BPMNShape id="Shape_Participant_task_lifecycle" bpmnElement="Participant_task_lifecycle" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2920" height="1160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_cli" bpmnElement="Lane_cli" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2890" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_bot" bpmnElement="Lane_bot" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="2890" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_msg" bpmnElement="Lane_msg" isHorizontal="true">
        <dc:Bounds x="190" y="440" width="2890" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_emp" bpmnElement="Lane_emp" isHorizontal="true">
        <dc:Bounds x="190" y="750" width="2890" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_crm" bpmnElement="Lane_crm" isHorizontal="true">
        <dc:Bounds x="190" y="1060" width="2890" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_task" bpmnElement="Start_task">
        <dc:Bounds x="267" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="232" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_parse" bpmnElement="T_parse">
        <dc:Bounds x="415" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_chat" bpmnElement="T_chat">
        <dc:Bounds x="605" y="490" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_deal" bpmnElement="T_deal">
        <dc:Bounds x="795" y="1110" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_assign" bpmnElement="T_assign">
        <dc:Bounds x="985" y="490" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_take" bpmnElement="T_take">
        <dc:Bounds x="1175" y="800" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_timer" bpmnElement="T_timer">
        <dc:Bounds x="1365" y="490" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_work" bpmnElement="T_work">
        <dc:Bounds x="1555" y="800" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_sla" bpmnElement="G_sla">
        <dc:Bounds x="1780" y="505" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1745" y="561" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_escalate" bpmnElement="T_escalate">
        <dc:Bounds x="1935" y="620" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_review" bpmnElement="T_review">
        <dc:Bounds x="2125" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_accept" bpmnElement="G_accept">
        <dc:Bounds x="2350" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2315" y="201" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_rework" bpmnElement="T_rework">
        <dc:Bounds x="2505" y="930" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_rework" bpmnElement="End_rework">
        <dc:Bounds x="2737" y="952" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2702" y="994" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_rate" bpmnElement="T_rate">
        <dc:Bounds x="2505" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_close" bpmnElement="T_close">
        <dc:Bounds x="2695" y="1110" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_done" bpmnElement="End_done">
        <dc:Bounds x="2927" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2892" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="303" y="170" />
        <di:waypoint x="359" y="170" />
        <di:waypoint x="359" y="350" />
        <di:waypoint x="415" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="535" y="350" />
        <di:waypoint x="570" y="350" />
        <di:waypoint x="570" y="530" />
        <di:waypoint x="605" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03">
        <di:waypoint x="725" y="530" />
        <di:waypoint x="760" y="530" />
        <di:waypoint x="760" y="1150" />
        <di:waypoint x="795" y="1150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04">
        <di:waypoint x="915" y="1150" />
        <di:waypoint x="950" y="1150" />
        <di:waypoint x="950" y="530" />
        <di:waypoint x="985" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="1105" y="530" />
        <di:waypoint x="1140" y="530" />
        <di:waypoint x="1140" y="840" />
        <di:waypoint x="1175" y="840" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="1295" y="840" />
        <di:waypoint x="1330" y="840" />
        <di:waypoint x="1330" y="530" />
        <di:waypoint x="1365" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07" bpmnElement="Flow_07">
        <di:waypoint x="1485" y="530" />
        <di:waypoint x="1520" y="530" />
        <di:waypoint x="1520" y="840" />
        <di:waypoint x="1555" y="840" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08">
        <di:waypoint x="1675" y="840" />
        <di:waypoint x="1727" y="840" />
        <di:waypoint x="1727" y="530" />
        <di:waypoint x="1780" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09" bpmnElement="Flow_09">
        <di:waypoint x="1830" y="530" />
        <di:waypoint x="1977" y="530" />
        <di:waypoint x="1977" y="170" />
        <di:waypoint x="2125" y="170" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1957" y="146" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1830" y="530" />
        <di:waypoint x="1882" y="530" />
        <di:waypoint x="1882" y="660" />
        <di:waypoint x="1935" y="660" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1862" y="636" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="2055" y="660" />
        <di:waypoint x="2090" y="660" />
        <di:waypoint x="2090" y="170" />
        <di:waypoint x="2125" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="2245" y="170" />
        <di:waypoint x="2350" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13">
        <di:waypoint x="2400" y="170" />
        <di:waypoint x="2505" y="170" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2485" y="146" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_14" bpmnElement="Flow_14">
        <di:waypoint x="2400" y="170" />
        <di:waypoint x="2452" y="170" />
        <di:waypoint x="2452" y="970" />
        <di:waypoint x="2505" y="970" />
