        <di:waypoint x="1865" y="660" />
        <di:waypoint x="1995" y="660" />
        <di:waypoint x="1995" y="1020" />
        <di:waypoint x="2125" y="1020" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_15" bpmnElement="Flow_15">
        <di:waypoint x="2055" y="840" />
