<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_medical_approval"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="sa-portfolio/tools/bpmn_gen.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_medical_approval">
    <bpmn:participant id="Participant_medical_approval" name="Проверка протокола клиники на соответствие правилам" processRef="Process_medical_approval" />
  </bpmn:collaboration>
  <bpmn:process id="Process_medical_approval" name="Согласование медицинского назначения" isExecutable="false">
    <bpmn:documentation>Протокол из клиники проверяется на соответствие клиническим рекомендациям и условиям полиса. Спорные случаи уходят врачу-эксперту: автомат не отказывает в лечении единолично.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_medical_approval">
      <bpmn:lane id="Lane_clinic" name="Клиника">
        <bpmn:flowNodeRef>Start_protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ocr" name="Распознавание документа">
        <bpmn:flowNodeRef>T_ocr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_quality</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_rules" name="Клинический движок">
        <bpmn:flowNodeRef>T_map</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_verdict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_expert" name="Врач-эксперт">
        <bpmn:flowNodeRef>T_manual_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_expert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_decide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_reg" name="Учётная система">
        <bpmn:flowNodeRef>T_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_notify</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Start_protocol" name="Клиника прислала
протокол назначения">
        <bpmn:outgoing>Flow_01</bpmn:outgoing>
        <bpmn:messageEventDefinition />
      </bpmn:startEvent>
      <bpmn:serviceTask id="T_ocr" name="Распознать документ
с сохранением структуры">
        <bpmn:incoming>Flow_01</bpmn:incoming>
        <bpmn:outgoing>Flow_02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_ner" name="Извлечь диагнозы,
услуги, назначения">
        <bpmn:incoming>Flow_02</bpmn:incoming>
        <bpmn:outgoing>Flow_03</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_quality" name="Качество распознавания
достаточное?">
        <bpmn:incoming>Flow_03</bpmn:incoming>
        <bpmn:outgoing>Flow_04</bpmn:outgoing>
        <bpmn:outgoing>Flow_05</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_manual_read" name="Прочитать документ
вручную">
        <bpmn:incoming>Flow_05</bpmn:incoming>
        <bpmn:outgoing>Flow_06</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_map" name="Сопоставить с МКБ-10
и клиническими рекомендациями">
        <bpmn:incoming>Flow_04</bpmn:incoming>
        <bpmn:incoming>Flow_06</bpmn:incoming>
        <bpmn:outgoing>Flow_07</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_check" name="Проверить назначение
по правилам и полису">
        <bpmn:incoming>Flow_07</bpmn:incoming>
        <bpmn:outgoing>Flow_08</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_verdict" name="Соответствует
правилам?">
        <bpmn:incoming>Flow_08</bpmn:incoming>
        <bpmn:outgoing>Flow_09</bpmn:outgoing>
        <bpmn:outgoing>Flow_10</bpmn:outgoing>
        <bpmn:outgoing>Flow_11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_approve" name="Сформировать решение
о согласовании">
        <bpmn:incoming>Flow_09</bpmn:incoming>
        <bpmn:outgoing>Flow_13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_reject" name="Сформировать
мотивированный отказ">
        <bpmn:incoming>Flow_10</bpmn:incoming>
        <bpmn:outgoing>Flow_14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="T_expert" name="Передать случай
врачу-эксперту">
        <bpmn:incoming>Flow_11</bpmn:incoming>
        <bpmn:outgoing>Flow_12</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="T_decide" name="Принять решение
по спорному случаю">
        <bpmn:incoming>Flow_12</bpmn:incoming>
        <bpmn:outgoing>Flow_15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_record" name="Зафиксировать решение
и обоснование">
        <bpmn:incoming>Flow_13</bpmn:incoming>
        <bpmn:incoming>Flow_14</bpmn:incoming>
        <bpmn:incoming>Flow_15</bpmn:incoming>
        <bpmn:outgoing>Flow_16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="T_notify" name="Отправить решение
в клинику">
        <bpmn:incoming>Flow_16</bpmn:incoming>
        <bpmn:outgoing>Flow_17</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="End_done" name="Клиника
получила решение">
        <bpmn:incoming>Flow_17</bpmn:incoming>
        <bpmn:messageEventDefinition />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_protocol" targetRef="T_ocr" />
      <bpmn:sequenceFlow id="Flow_02" sourceRef="T_ocr" targetRef="T_ner" />
      <bpmn:sequenceFlow id="Flow_03" sourceRef="T_ner" targetRef="G_quality" />
      <bpmn:sequenceFlow id="Flow_04" name="да" sourceRef="G_quality" targetRef="T_map" />
      <bpmn:sequenceFlow id="Flow_05" name="нет" sourceRef="G_quality" targetRef="T_manual_read" />
      <bpmn:sequenceFlow id="Flow_06" sourceRef="T_manual_read" targetRef="T_map" />
      <bpmn:sequenceFlow id="Flow_07" sourceRef="T_map" targetRef="T_check" />
      <bpmn:sequenceFlow id="Flow_08" sourceRef="T_check" targetRef="G_verdict" />
      <bpmn:sequenceFlow id="Flow_09" name="да" sourceRef="G_verdict" targetRef="T_approve" />
      <bpmn:sequenceFlow id="Flow_10" name="нет" sourceRef="G_verdict" targetRef="T_reject" />
      <bpmn:sequenceFlow id="Flow_11" name="спорно" sourceRef="G_verdict" targetRef="T_expert" />
      <bpmn:sequenceFlow id="Flow_12" sourceRef="T_expert" targetRef="T_decide" />
      <bpmn:sequenceFlow id="Flow_13" sourceRef="T_approve" targetRef="T_record" />
      <bpmn:sequenceFlow id="Flow_14" sourceRef="T_reject" targetRef="T_record" />
      <bpmn:sequenceFlow id="Flow_15" sourceRef="T_decide" targetRef="T_record" />
      <bpmn:sequenceFlow id="Flow_16" sourceRef="T_record" targetRef="T_notify" />
      <bpmn:sequenceFlow id="Flow_17" sourceRef="T_notify" targetRef="End_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_medical_approval">
    <bpmndi:BPMNPlane id="Plane_medical_approval" bpmnElement="Collaboration_medical_approval">
      <bpmndi:BPMNShape id="Shape_Participant_medical_approval" bpmnElement="Participant_medical_approval" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2540" height="1030" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_clinic" bpmnElement="Lane_clinic" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2510" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_ocr" bpmnElement="Lane_ocr" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="2510" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_rules" bpmnElement="Lane_rules" isHorizontal="true">
        <dc:Bounds x="190" y="440" width="2510" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_expert" bpmnElement="Lane_expert" isHorizontal="true">
        <dc:Bounds x="190" y="750" width="2510" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_reg" bpmnElement="Lane_reg" isHorizontal="true">
        <dc:Bounds x="190" y="930" width="2510" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_protocol" bpmnElement="Start_protocol">
        <dc:Bounds x="267" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="232" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_ocr" bpmnElement="T_ocr">
        <dc:Bounds x="415" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_ner" bpmnElement="T_ner">
        <dc:Bounds x="605" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_quality" bpmnElement="G_quality">
        <dc:Bounds x="830" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="795" y="381" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_manual_read" bpmnElement="T_manual_read">
        <dc:Bounds x="985" y="800" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_map" bpmnElement="T_map">
        <dc:Bounds x="1175" y="490" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_check" bpmnElement="T_check">
        <dc:Bounds x="1365" y="490" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_verdict" bpmnElement="G_verdict">
        <dc:Bounds x="1590" y="505" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1555" y="561" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_approve" bpmnElement="T_approve">
        <dc:Bounds x="1745" y="490" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_reject" bpmnElement="T_reject">
        <dc:Bounds x="1745" y="620" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_expert" bpmnElement="T_expert">
        <dc:Bounds x="1745" y="800" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_decide" bpmnElement="T_decide">
        <dc:Bounds x="1935" y="800" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_record" bpmnElement="T_record">
        <dc:Bounds x="2125" y="980" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_notify" bpmnElement="T_notify">
        <dc:Bounds x="2315" y="980" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_done" bpmnElement="End_done">
        <dc:Bounds x="2547" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2512" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="303" y="170" />
        <di:waypoint x="359" y="170" />
        <di:waypoint x="359" y="350" />
        <di:waypoint x="415" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="535" y="350" />
        <di:waypoint x="605" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03">
        <di:waypoint x="725" y="350" />
        <di:waypoint x="830" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04">
        <di:waypoint x="880" y="350" />
        <di:waypoint x="1027" y="350" />
        <di:waypoint x="1027" y="530" />
        <di:waypoint x="1175" y="530" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1007" y="506" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="880" y="350" />
        <di:waypoint x="932" y="350" />
        <di:waypoint x="932" y="840" />
        <di:waypoint x="985" y="840" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="912" y="816" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="1105" y="840" />
        <di:waypoint x="1140" y="840" />
        <di:waypoint x="1140" y="530" />
        <di:waypoint x="1175" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07" bpmnElement="Flow_07">
        <di:waypoint x="1295" y="530" />
        <di:waypoint x="1365" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08">
        <di:waypoint x="1485" y="530" />
        <di:waypoint x="1590" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09" bpmnElement="Flow_09">
        <di:waypoint x="1640" y="530" />
        <di:waypoint x="1745" y="530" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1725" y="506" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1640" y="530" />
        <di:waypoint x="1692" y="530" />
        <di:waypoint x="1692" y="660" />
        <di:waypoint x="1745" y="660" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1672" y="636" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1640" y="530" />
        <di:waypoint x="1692" y="530" />
        <di:waypoint x="1692" y="840" />
        <di:waypoint x="1745" y="840" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1672" y="816" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="1865" y="840" />
        <di:waypoint x="1935" y="840" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13">
        <di:waypoint x="1865" y="530" />
        <di:waypoint x="1995" y="530" />
        <di:waypoint x="1995" y="1020" />
        <di:waypoint x="2125" y="1020" />
      </bpmndi:BPMNEdge>
