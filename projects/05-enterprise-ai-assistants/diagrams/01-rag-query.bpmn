      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_17" bpmnElement="Flow_17">
        <di:waypoint x="2435" y="350" />
        <di:waypoint x="2470" y="350" />
        <di:waypoint x="2470" y="1150" />
        <di:waypoint x="2505" y="1150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_18" bpmnElement="Flow_18">
        <di:waypoint x="2625" y="1150" />
        <di:waypoint x="2681" y="1150" />
        <di:waypoint x="2681" y="170" />
        <di:waypoint x="2737" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
