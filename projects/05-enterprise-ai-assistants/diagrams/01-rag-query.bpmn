<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_rag_query"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="portfolio/tools/bpmn_gen.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_rag_query">
    <bpmn:participant id="Participant_rag_query" name="AI-Librarium: поиск по локальным нормативным актам" processRef="Process_rag_query" />
  </bpmn:collaboration>
  <bpmn:process id="Process_rag_query" name="Ответ на вопрос по нормативной базе" isExecutable="false">
    <bpmn:documentation>Сотрудник задаёт вопрос на естественном языке, система отвечает с обязательными ссылками на пункты ЛНА. Ответ без подтверждённого источника не выдаётся как утверждение.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_rag_query">
      <bpmn:lane id="Lane_emp" name="Сотрудник">
        <bpmn:flowNodeRef>Start_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_orch" name="Оркестратор (LangGraph)">
        <bpmn:flowNodeRef>T_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_scope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_narrow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_nofound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_nofound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_answer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_search" name="Поисковый слой">
        <bpmn:flowNodeRef>T_hybrid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_rerank</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_llm" name="LLM-контур (on-premises)">
        <bpmn:flowNodeRef>T_prompt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ground</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ground</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_flag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_partial</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_audit" name="Журнал">
        <bpmn:flowNodeRef>T_log</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Start_q" name="Сотрудник задаёт
вопрос">
        <bpmn:outgoing>Flow_01</bpmn:outgoing>
        <bpmn:messageEventDefinition />
      </bpmn:startEvent>
      <bpmn:serviceTask id="T_auth" name="Определить права
через Active Directory">
        <bpmn:incoming>Flow_01</bpmn:incoming>
        <bpmn:outgoing>Flow_02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_scope" name="Доступны все
разделы базы?">
        <bpmn:incoming>Flow_02</bpmn:incoming>
        <bpmn:outgoing>Flow_03</bpmn:outgoing>
        <bpmn:outgoing>Flow_04</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_narrow" name="Сузить область поиска
до доступных документов">
        <bpmn:incoming>Flow_04</bpmn:incoming>
        <bpmn:outgoing>Flow_05</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_hybrid" name="Гибридный поиск:
векторный + BM25">
        <bpmn:incoming>Flow_03</bpmn:incoming>
        <bpmn:incoming>Flow_05</bpmn:incoming>
        <bpmn:outgoing>Flow_06</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_rerank" name="Переранжировать
и отобрать топ-K фрагментов">
        <bpmn:incoming>Flow_06</bpmn:incoming>
        <bpmn:outgoing>Flow_07</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_found" name="Есть релевантные
фрагменты?">
        <bpmn:incoming>Flow_07</bpmn:incoming>
        <bpmn:outgoing>Flow_08</bpmn:outgoing>
        <bpmn:outgoing>Flow_09</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="T_nofound" name="Сообщить, что ответа
в базе нет">
        <bpmn:incoming>Flow_09</bpmn:incoming>
        <bpmn:outgoing>Flow_10</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="End_nofound" name="Ответ не найден">
        <bpmn:incoming>Flow_10</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="T_prompt" name="Собрать промпт
с цитатами и ограничениями">
        <bpmn:incoming>Flow_08</bpmn:incoming>
        <bpmn:outgoing>Flow_11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_generate" name="Сгенерировать ответ
локальной моделью">
        <bpmn:incoming>Flow_11</bpmn:incoming>
        <bpmn:outgoing>Flow_12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_ground" name="Проверить опору
каждого утверждения на источник">
        <bpmn:incoming>Flow_12</bpmn:incoming>
        <bpmn:outgoing>Flow_13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_ground" name="Все утверждения
подтверждены?">
        <bpmn:incoming>Flow_13</bpmn:incoming>
        <bpmn:outgoing>Flow_14</bpmn:outgoing>
        <bpmn:outgoing>Flow_15</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="T_flag" name="Выдать только цитаты
без обобщения">
        <bpmn:incoming>Flow_15</bpmn:incoming>
        <bpmn:outgoing>Flow_16</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="End_partial" name="Ответ с оговоркой">
        <bpmn:incoming>Flow_16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sendTask id="T_answer" name="Показать ответ
со ссылками на пункты ЛНА">
        <bpmn:incoming>Flow_14</bpmn:incoming>
        <bpmn:outgoing>Flow_17</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:serviceTask id="T_log" name="Записать вопрос, источники
и ответ в журнал">
        <bpmn:incoming>Flow_17</bpmn:incoming>
        <bpmn:outgoing>Flow_18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_done" name="Сотрудник
получил ответ">
        <bpmn:incoming>Flow_18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_q" targetRef="T_auth" />
      <bpmn:sequenceFlow id="Flow_02" sourceRef="T_auth" targetRef="G_scope" />
      <bpmn:sequenceFlow id="Flow_03" name="да" sourceRef="G_scope" targetRef="T_hybrid" />
      <bpmn:sequenceFlow id="Flow_04" name="нет" sourceRef="G_scope" targetRef="T_narrow" />
      <bpmn:sequenceFlow id="Flow_05" sourceRef="T_narrow" targetRef="T_hybrid" />
      <bpmn:sequenceFlow id="Flow_06" sourceRef="T_hybrid" targetRef="T_rerank" />
      <bpmn:sequenceFlow id="Flow_07" sourceRef="T_rerank" targetRef="G_found" />
      <bpmn:sequenceFlow id="Flow_08" name="да" sourceRef="G_found" targetRef="T_prompt" />
      <bpmn:sequenceFlow id="Flow_09" name="нет" sourceRef="G_found" targetRef="T_nofound" />
      <bpmn:sequenceFlow id="Flow_10" sourceRef="T_nofound" targetRef="End_nofound" />
      <bpmn:sequenceFlow id="Flow_11" sourceRef="T_prompt" targetRef="T_generate" />
      <bpmn:sequenceFlow id="Flow_12" sourceRef="T_generate" targetRef="T_ground" />
      <bpmn:sequenceFlow id="Flow_13" sourceRef="T_ground" targetRef="G_ground" />
      <bpmn:sequenceFlow id="Flow_14" name="да" sourceRef="G_ground" targetRef="T_answer" />
      <bpmn:sequenceFlow id="Flow_15" name="нет" sourceRef="G_ground" targetRef="T_flag" />
      <bpmn:sequenceFlow id="Flow_16" sourceRef="T_flag" targetRef="End_partial" />
      <bpmn:sequenceFlow id="Flow_17" sourceRef="T_answer" targetRef="T_log" />
      <bpmn:sequenceFlow id="Flow_18" sourceRef="T_log" targetRef="End_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_rag_query">
    <bpmndi:BPMNPlane id="Plane_rag_query" bpmnElement="Collaboration_rag_query">
      <bpmndi:BPMNShape id="Shape_Participant_rag_query" bpmnElement="Participant_rag_query" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2730" height="1160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_emp" bpmnElement="Lane_emp" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2700" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_orch" bpmnElement="Lane_orch" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="2700" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_search" bpmnElement="Lane_search" isHorizontal="true">
        <dc:Bounds x="190" y="570" width="2700" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_llm" bpmnElement="Lane_llm" isHorizontal="true">
        <dc:Bounds x="190" y="750" width="2700" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_audit" bpmnElement="Lane_audit" isHorizontal="true">
        <dc:Bounds x="190" y="1060" width="2700" height="180" />
      </bpmndi:BPMNShape>
