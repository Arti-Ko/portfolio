        <dc:Bounds x="415" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_scope" bpmnElement="G_scope">
        <dc:Bounds x="640" y="325" width="50" height="50" />
