          <dc:Bounds x="605" y="381" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_narrow" bpmnElement="T_narrow">
        <dc:Bounds x="795" y="440" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_hybrid" bpmnElement="T_hybrid">
        <dc:Bounds x="985" y="620" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_rerank" bpmnElement="T_rerank">
        <dc:Bounds x="1175" y="620" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_found" bpmnElement="G_found">
        <dc:Bounds x="1400" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1365" y="381" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_nofound" bpmnElement="T_nofound">
        <dc:Bounds x="1555" y="440" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_nofound" bpmnElement="End_nofound">
        <dc:Bounds x="1787" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1752" y="504" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_prompt" bpmnElement="T_prompt">
        <dc:Bounds x="1555" y="800" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_generate" bpmnElement="T_generate">
        <dc:Bounds x="1745" y="800" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_ground" bpmnElement="T_ground">
        <dc:Bounds x="1935" y="800" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_ground" bpmnElement="G_ground">
        <dc:Bounds x="2160" y="815" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2125" y="871" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_flag" bpmnElement="T_flag">
        <dc:Bounds x="2315" y="930" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_partial" bpmnElement="End_partial">
        <dc:Bounds x="2547" y="952" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2512" y="994" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_answer" bpmnElement="T_answer">
        <dc:Bounds x="2315" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_log" bpmnElement="T_log">
        <dc:Bounds x="2505" y="1110" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_done" bpmnElement="End_done">
        <dc:Bounds x="2737" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2702" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="303" y="170" />
        <di:waypoint x="359" y="170" />
        <di:waypoint x="359" y="350" />
        <di:waypoint x="415" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="535" y="350" />
        <di:waypoint x="640" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03">
        <di:waypoint x="690" y="350" />
        <di:waypoint x="837" y="350" />
        <di:waypoint x="837" y="660" />
        <di:waypoint x="985" y="660" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="817" y="636" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04">
        <di:waypoint x="690" y="350" />
        <di:waypoint x="742" y="350" />
        <di:waypoint x="742" y="480" />
        <di:waypoint x="795" y="480" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="722" y="456" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="915" y="480" />
        <di:waypoint x="950" y="480" />
        <di:waypoint x="950" y="660" />
        <di:waypoint x="985" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="1105" y="660" />
        <di:waypoint x="1175" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07" bpmnElement="Flow_07">
        <di:waypoint x="1295" y="660" />
        <di:waypoint x="1347" y="660" />
        <di:waypoint x="1347" y="350" />
        <di:waypoint x="1400" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08">
        <di:waypoint x="1450" y="350" />
        <di:waypoint x="1502" y="350" />
        <di:waypoint x="1502" y="840" />
        <di:waypoint x="1555" y="840" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1482" y="816" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09" bpmnElement="Flow_09">
        <di:waypoint x="1450" y="350" />
        <di:waypoint x="1502" y="350" />
        <di:waypoint x="1502" y="480" />
        <di:waypoint x="1555" y="480" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1482" y="456" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1675" y="480" />
        <di:waypoint x="1787" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1675" y="840" />
        <di:waypoint x="1745" y="840" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="1865" y="840" />
        <di:waypoint x="1935" y="840" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13">
        <di:waypoint x="2055" y="840" />
