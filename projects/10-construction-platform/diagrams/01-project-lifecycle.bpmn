<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_construction_project"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="sa-portfolio/tools/bpmn_gen.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_construction_project">
    <bpmn:participant id="Participant_construction_project" name="Закрытый тендер и выбор подрядчика" processRef="Process_construction_project" />
  </bpmn:collaboration>
  <bpmn:process id="Process_construction_project" name="От технического задания до старта работ" isExecutable="false">
    <bpmn:documentation>Платформа выступает управляемым посредником: подрядчиков приглашает менеджер вручную из аккредитованного пула, публичного доступа к тендеру нет.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_construction_project">
      <bpmn:lane id="Lane_cli" name="Клиент">
        <bpmn:flowNodeRef>Start_need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_brief</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_started</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_mgr" name="Менеджер платформы">
        <bpmn:flowNodeRef>T_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_stages</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_con" name="Подрядчик">
        <bpmn:flowNodeRef>T_bid</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Start_need" name="У клиента появилась
задача">
        <bpmn:outgoing>Flow_01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="T_brief" name="Создать ТЗ: описание,
бюджет, сроки, файлы">
        <bpmn:incoming>Flow_01</bpmn:incoming>
        <bpmn:outgoing>Flow_02</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_validate" name="Проверить
и уточнить ТЗ">
        <bpmn:incoming>Flow_02</bpmn:incoming>
        <bpmn:outgoing>Flow_03</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_ready" name="ТЗ готово
к тендеру?">
        <bpmn:incoming>Flow_03</bpmn:incoming>
        <bpmn:outgoing>Flow_04</bpmn:outgoing>
        <bpmn:outgoing>Flow_05</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_open" name="Открыть
закрытый тендер">
        <bpmn:incoming>Flow_04</bpmn:incoming>
        <bpmn:outgoing>Flow_07</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="T_clarify" name="Вернуть клиенту
на уточнение">
        <bpmn:incoming>Flow_05</bpmn:incoming>
        <bpmn:outgoing>Flow_06</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="End_draft" name="ТЗ в черновике">
        <bpmn:incoming>Flow_06</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sendTask id="T_invite" name="Пригласить аккредитованных
подрядчиков">
        <bpmn:incoming>Flow_07</bpmn:incoming>
        <bpmn:outgoing>Flow_08</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="T_bid" name="Подать КП
с разбивкой по этапам">
        <bpmn:incoming>Flow_08</bpmn:incoming>
        <bpmn:outgoing>Flow_09</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_check" name="Проверить полноту КП
и адекватность смет">
        <bpmn:incoming>Flow_09</bpmn:incoming>
        <bpmn:outgoing>Flow_10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_compare" name="Сравнить
предложения">
        <bpmn:incoming>Flow_10</bpmn:incoming>
        <bpmn:outgoing>Flow_11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_choose" name="Выбрать подрядчика">
        <bpmn:incoming>Flow_11</bpmn:incoming>
        <bpmn:outgoing>Flow_12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_stages" name="Сформировать таблицу этапов
из выбранного КП">
        <bpmn:incoming>Flow_12</bpmn:incoming>
        <bpmn:outgoing>Flow_13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_started" name="Проект переведён
в работу">
        <bpmn:incoming>Flow_13</bpmn:incoming>
        <bpmn:messageEventDefinition />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_need" targetRef="T_brief" />
      <bpmn:sequenceFlow id="Flow_02" sourceRef="T_brief" targetRef="T_validate" />
      <bpmn:sequenceFlow id="Flow_03" sourceRef="T_validate" targetRef="G_ready" />
      <bpmn:sequenceFlow id="Flow_04" name="да" sourceRef="G_ready" targetRef="T_open" />
      <bpmn:sequenceFlow id="Flow_05" name="нет" sourceRef="G_ready" targetRef="T_clarify" />
      <bpmn:sequenceFlow id="Flow_06" sourceRef="T_clarify" targetRef="End_draft" />
      <bpmn:sequenceFlow id="Flow_07" sourceRef="T_open" targetRef="T_invite" />
      <bpmn:sequenceFlow id="Flow_08" sourceRef="T_invite" targetRef="T_bid" />
      <bpmn:sequenceFlow id="Flow_09" sourceRef="T_bid" targetRef="T_check" />
      <bpmn:sequenceFlow id="Flow_10" sourceRef="T_check" targetRef="T_compare" />
      <bpmn:sequenceFlow id="Flow_11" sourceRef="T_compare" targetRef="T_choose" />
      <bpmn:sequenceFlow id="Flow_12" sourceRef="T_choose" targetRef="T_stages" />
      <bpmn:sequenceFlow id="Flow_13" sourceRef="T_stages" targetRef="End_started" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_construction_project">
    <bpmndi:BPMNPlane id="Plane_construction_project" bpmnElement="Collaboration_construction_project">
      <bpmndi:BPMNShape id="Shape_Participant_construction_project" bpmnElement="Participant_construction_project" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2350" height="670" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_cli" bpmnElement="Lane_cli" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2320" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_mgr" bpmnElement="Lane_mgr" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="2320" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_con" bpmnElement="Lane_con" isHorizontal="true">
        <dc:Bounds x="190" y="570" width="2320" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_need" bpmnElement="Start_need">
        <dc:Bounds x="267" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="232" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_brief" bpmnElement="T_brief">
        <dc:Bounds x="415" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_validate" bpmnElement="T_validate">
        <dc:Bounds x="605" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_ready" bpmnElement="G_ready">
        <dc:Bounds x="830" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="795" y="381" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_open" bpmnElement="T_open">
        <dc:Bounds x="985" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_clarify" bpmnElement="T_clarify">
        <dc:Bounds x="985" y="440" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_draft" bpmnElement="End_draft">
        <dc:Bounds x="1217" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1182" y="504" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_invite" bpmnElement="T_invite">
        <dc:Bounds x="1175" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_bid" bpmnElement="T_bid">
        <dc:Bounds x="1365" y="620" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_check" bpmnElement="T_check">
        <dc:Bounds x="1555" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_compare" bpmnElement="T_compare">
        <dc:Bounds x="1745" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_choose" bpmnElement="T_choose">
        <dc:Bounds x="1935" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_stages" bpmnElement="T_stages">
        <dc:Bounds x="2125" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_started" bpmnElement="End_started">
        <dc:Bounds x="2357" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2322" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="303" y="170" />
        <di:waypoint x="415" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="535" y="170" />
        <di:waypoint x="570" y="170" />
        <di:waypoint x="570" y="350" />
        <di:waypoint x="605" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03">
        <di:waypoint x="725" y="350" />
        <di:waypoint x="830" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04">
        <di:waypoint x="880" y="350" />
        <di:waypoint x="985" y="350" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="965" y="326" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="880" y="350" />
        <di:waypoint x="932" y="350" />
        <di:waypoint x="932" y="480" />
        <di:waypoint x="985" y="480" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="912" y="456" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="1105" y="480" />
        <di:waypoint x="1217" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07" bpmnElement="Flow_07">
        <di:waypoint x="1105" y="350" />
        <di:waypoint x="1175" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08">
        <di:waypoint x="1295" y="350" />
        <di:waypoint x="1330" y="350" />
        <di:waypoint x="1330" y="660" />
        <di:waypoint x="1365" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09" bpmnElement="Flow_09">
        <di:waypoint x="1485" y="660" />
        <di:waypoint x="1520" y="660" />
        <di:waypoint x="1520" y="350" />
        <di:waypoint x="1555" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1675" y="350" />
        <di:waypoint x="1710" y="350" />
        <di:waypoint x="1710" y="170" />
        <di:waypoint x="1745" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1865" y="170" />
        <di:waypoint x="1935" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="2055" y="170" />
        <di:waypoint x="2090" y="170" />
        <di:waypoint x="2090" y="350" />
        <di:waypoint x="2125" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13">
        <di:waypoint x="2245" y="350" />
        <di:waypoint x="2301" y="350" />
        <di:waypoint x="2301" y="170" />
        <di:waypoint x="2357" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
