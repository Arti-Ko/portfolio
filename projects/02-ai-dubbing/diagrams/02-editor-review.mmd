flowchart LR
    subgraph Lane_editor["Технический редактор"]
        direction LR
        Start_rework(("Поступила задача<br/>на правку"))
        T_listen["Прослушать сегменты<br/>с низкой метрикой"]
        G_defect{"Тип дефекта?"}
        T_fix_text["Исправить перевод<br/>и глоссарий терминов"]
        T_fix_phon["Задать транскрипцию<br/>(SSML / фонемы)"]
        T_fix_time["Скорректировать тайм-коды<br/>и темп речи"]
        T_mos["Собрать оценки MOS<br/>на выборке сегментов"]
        G_mos{"MOS ≥ 4.0?"}
    end
    subgraph Lane_orch["Оркестратор пайплайна"]
        direction LR
        T_resynth["Пересинтезировать<br/>только изменённые сегменты"]
        T_remix["Пересобрать дорожку<br/>и обновить превью"]
        T_escalate["Сменить голос / провайдера<br/>и перезапустить пайплайн"]
        T_publish["Опубликовать<br/>принятую версию"]
        End_escalated(("Требуется смена<br/>конфигурации"))
    end
    subgraph Lane_producer["Продюсер"]
        direction LR
        T_accept["Согласовать<br/>финальную дорожку"]
        End_accepted(("Дубляж принят"))
    end
    Start_rework --> T_listen
    T_listen --> G_defect
    G_defect -- "перевод" --> T_fix_text
    G_defect -- "произношение" --> T_fix_phon
    G_defect -- "тайминг" --> T_fix_time
    T_fix_text --> T_resynth
    T_fix_phon --> T_resynth
    T_fix_time --> T_resynth
    T_resynth --> T_remix
    T_remix --> T_mos
    T_mos --> G_mos
    G_mos -- "да" --> T_accept
    G_mos -- "нет" --> T_escalate
    T_escalate --> End_escalated
    T_accept --> T_publish
    T_publish --> End_accepted
