<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_dubbing_review"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="sa-portfolio/tools/bpmn_gen.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_dubbing_review">
    <bpmn:participant id="Participant_dubbing_review" name="Редактирование и контроль качества дубляжа" processRef="Process_dubbing_review" />
  </bpmn:collaboration>
  <bpmn:process id="Process_dubbing_review" name="Ручная правка и приёмка озвучки" isExecutable="false">
    <bpmn:documentation>Процесс запускается, когда автоконтроль отклонил выпуск. Редактор правит причину дефекта, пересинтезируются только затронутые сегменты, приёмка идёт по MOS-тесту.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_dubbing_review">
      <bpmn:lane id="Lane_editor" name="Технический редактор">
        <bpmn:flowNodeRef>Start_rework</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_listen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_defect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_fix_text</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_fix_phon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_fix_time</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_mos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_mos</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_orch" name="Оркестратор пайплайна">
        <bpmn:flowNodeRef>T_resynth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_remix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_escalated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_publish</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_producer" name="Продюсер">
        <bpmn:flowNodeRef>T_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_accepted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Start_rework" name="Поступила задача
на правку">
        <bpmn:outgoing>Flow_01</bpmn:outgoing>
        <bpmn:messageEventDefinition />
      </bpmn:startEvent>
      <bpmn:userTask id="T_listen" name="Прослушать сегменты
с низкой метрикой">
        <bpmn:incoming>Flow_01</bpmn:incoming>
        <bpmn:outgoing>Flow_02</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_defect" name="Тип дефекта?">
        <bpmn:incoming>Flow_02</bpmn:incoming>
        <bpmn:outgoing>Flow_03</bpmn:outgoing>
        <bpmn:outgoing>Flow_04</bpmn:outgoing>
        <bpmn:outgoing>Flow_05</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_fix_text" name="Исправить перевод
и глоссарий терминов">
        <bpmn:incoming>Flow_03</bpmn:incoming>
        <bpmn:outgoing>Flow_06</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_fix_phon" name="Задать транскрипцию
(SSML / фонемы)">
        <bpmn:incoming>Flow_04</bpmn:incoming>
        <bpmn:outgoing>Flow_07</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_fix_time" name="Скорректировать тайм-коды
и темп речи">
        <bpmn:incoming>Flow_05</bpmn:incoming>
        <bpmn:outgoing>Flow_08</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_resynth" name="Пересинтезировать
только изменённые сегменты">
        <bpmn:incoming>Flow_06</bpmn:incoming>
        <bpmn:incoming>Flow_07</bpmn:incoming>
        <bpmn:incoming>Flow_08</bpmn:incoming>
        <bpmn:outgoing>Flow_09</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_remix" name="Пересобрать дорожку
и обновить превью">
        <bpmn:incoming>Flow_09</bpmn:incoming>
        <bpmn:outgoing>Flow_10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="T_mos" name="Собрать оценки MOS
на выборке сегментов">
        <bpmn:incoming>Flow_10</bpmn:incoming>
        <bpmn:outgoing>Flow_11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_mos" name="MOS ≥ 4.0?">
        <bpmn:incoming>Flow_11</bpmn:incoming>
        <bpmn:outgoing>Flow_12</bpmn:outgoing>
        <bpmn:outgoing>Flow_13</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_escalate" name="Сменить голос / провайдера
и перезапустить пайплайн">
        <bpmn:incoming>Flow_13</bpmn:incoming>
        <bpmn:outgoing>Flow_14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_escalated" name="Требуется смена
конфигурации">
        <bpmn:incoming>Flow_14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="T_accept" name="Согласовать
финальную дорожку">
        <bpmn:incoming>Flow_12</bpmn:incoming>
        <bpmn:outgoing>Flow_15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_publish" name="Опубликовать
принятую версию">
        <bpmn:incoming>Flow_15</bpmn:incoming>
        <bpmn:outgoing>Flow_16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_accepted" name="Дубляж принят">
        <bpmn:incoming>Flow_16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_rework" targetRef="T_listen" />
      <bpmn:sequenceFlow id="Flow_02" sourceRef="T_listen" targetRef="G_defect" />
      <bpmn:sequenceFlow id="Flow_03" name="перевод" sourceRef="G_defect" targetRef="T_fix_text" />
      <bpmn:sequenceFlow id="Flow_04" name="произношение" sourceRef="G_defect" targetRef="T_fix_phon" />
      <bpmn:sequenceFlow id="Flow_05" name="тайминг" sourceRef="G_defect" targetRef="T_fix_time" />
      <bpmn:sequenceFlow id="Flow_06" sourceRef="T_fix_text" targetRef="T_resynth" />
      <bpmn:sequenceFlow id="Flow_07" sourceRef="T_fix_phon" targetRef="T_resynth" />
      <bpmn:sequenceFlow id="Flow_08" sourceRef="T_fix_time" targetRef="T_resynth" />
      <bpmn:sequenceFlow id="Flow_09" sourceRef="T_resynth" targetRef="T_remix" />
      <bpmn:sequenceFlow id="Flow_10" sourceRef="T_remix" targetRef="T_mos" />
      <bpmn:sequenceFlow id="Flow_11" sourceRef="T_mos" targetRef="G_mos" />
      <bpmn:sequenceFlow id="Flow_12" name="да" sourceRef="G_mos" targetRef="T_accept" />
      <bpmn:sequenceFlow id="Flow_13" name="нет" sourceRef="G_mos" targetRef="T_escalate" />
      <bpmn:sequenceFlow id="Flow_14" sourceRef="T_escalate" targetRef="End_escalated" />
      <bpmn:sequenceFlow id="Flow_15" sourceRef="T_accept" targetRef="T_publish" />
      <bpmn:sequenceFlow id="Flow_16" sourceRef="T_publish" targetRef="End_accepted" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_dubbing_review">
    <bpmndi:BPMNPlane id="Plane_dubbing_review" bpmnElement="Collaboration_dubbing_review">
      <bpmndi:BPMNShape id="Shape_Participant_dubbing_review" bpmnElement="Participant_dubbing_review" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2160" height="930" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_editor" bpmnElement="Lane_editor" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2130" height="440" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_orch" bpmnElement="Lane_orch" isHorizontal="true">
        <dc:Bounds x="190" y="520" width="2130" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_producer" bpmnElement="Lane_producer" isHorizontal="true">
        <dc:Bounds x="190" y="830" width="2130" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_rework" bpmnElement="Start_rework">
        <dc:Bounds x="267" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="232" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_listen" bpmnElement="T_listen">
        <dc:Bounds x="415" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_defect" bpmnElement="G_defect">
        <dc:Bounds x="640" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="605" y="201" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_fix_text" bpmnElement="T_fix_text">
        <dc:Bounds x="795" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_fix_phon" bpmnElement="T_fix_phon">
        <dc:Bounds x="795" y="260" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_fix_time" bpmnElement="T_fix_time">
        <dc:Bounds x="795" y="390" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_resynth" bpmnElement="T_resynth">
        <dc:Bounds x="985" y="570" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_remix" bpmnElement="T_remix">
        <dc:Bounds x="1175" y="570" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_mos" bpmnElement="T_mos">
        <dc:Bounds x="1365" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_mos" bpmnElement="G_mos">
        <dc:Bounds x="1590" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1555" y="201" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_escalate" bpmnElement="T_escalate">
        <dc:Bounds x="1745" y="700" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_escalated" bpmnElement="End_escalated">
        <dc:Bounds x="1977" y="722" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1942" y="764" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_accept" bpmnElement="T_accept">
        <dc:Bounds x="1745" y="880" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_publish" bpmnElement="T_publish">
        <dc:Bounds x="1935" y="570" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_accepted" bpmnElement="End_accepted">
        <dc:Bounds x="2167" y="902" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2132" y="944" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="303" y="170" />
        <di:waypoint x="415" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="535" y="170" />
        <di:waypoint x="640" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03">
        <di:waypoint x="690" y="170" />
        <di:waypoint x="795" y="170" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="775" y="146" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04">
        <di:waypoint x="690" y="170" />
        <di:waypoint x="742" y="170" />
        <di:waypoint x="742" y="300" />
        <di:waypoint x="795" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="722" y="276" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="690" y="170" />
        <di:waypoint x="742" y="170" />
        <di:waypoint x="742" y="430" />
        <di:waypoint x="795" y="430" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="722" y="406" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="915" y="170" />
        <di:waypoint x="950" y="170" />
        <di:waypoint x="950" y="610" />
        <di:waypoint x="985" y="610" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07" bpmnElement="Flow_07">
        <di:waypoint x="915" y="300" />
        <di:waypoint x="950" y="300" />
        <di:waypoint x="950" y="610" />
        <di:waypoint x="985" y="610" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08">
        <di:waypoint x="915" y="430" />
        <di:waypoint x="950" y="430" />
        <di:waypoint x="950" y="610" />
        <di:waypoint x="985" y="610" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09" bpmnElement="Flow_09">
        <di:waypoint x="1105" y="610" />
        <di:waypoint x="1175" y="610" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1295" y="610" />
        <di:waypoint x="1330" y="610" />
        <di:waypoint x="1330" y="170" />
        <di:waypoint x="1365" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1485" y="170" />
        <di:waypoint x="1590" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="1640" y="170" />
        <di:waypoint x="1692" y="170" />
        <di:waypoint x="1692" y="920" />
        <di:waypoint x="1745" y="920" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1672" y="896" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13">
        <di:waypoint x="1640" y="170" />
        <di:waypoint x="1692" y="170" />
        <di:waypoint x="1692" y="740" />
