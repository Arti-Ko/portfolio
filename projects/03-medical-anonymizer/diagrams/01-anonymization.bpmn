<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_phi_anonymization"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="sa-portfolio/tools/bpmn_gen.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_phi_anonymization">
    <bpmn:participant id="Participant_phi_anonymization" name="Сервис обезличивания ПДн" processRef="Process_phi_anonymization" />
  </bpmn:collaboration>
  <bpmn:process id="Process_phi_anonymization" name="Обезличивание медицинского документа" isExecutable="false">
    <bpmn:documentation>Документ приходит из МИС по защищённому каналу. Пайплайн распознаёт и маскирует ПДн, контрольный прогон ищет остаточные идентификаторы, любое действие фиксируется в неизменяемом аудит-логе.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_phi_anonymization">
      <bpmn:lane id="Lane_mis" name="МИС (система-источник)">
        <bpmn:flowNodeRef>Start_doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_api" name="API-шлюз">
        <bpmn:flowNodeRef>T_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_return</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_nlp" name="NLP-пайплайн">
        <bpmn:flowNodeRef>T_extract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_classify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_mask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_residual</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_dpo" name="Оператор ПДн">
        <bpmn:flowNodeRef>T_manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_quarantine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_quarantine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_store" name="Хранилище и аудит">
        <bpmn:flowNodeRef>T_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_audit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Start_doc" name="Документ отправлен
на обезличивание">
        <bpmn:outgoing>Flow_01</bpmn:outgoing>
        <bpmn:messageEventDefinition />
      </bpmn:startEvent>
      <bpmn:serviceTask id="T_auth" name="Аутентифицировать запрос:
mTLS, токен, схема">
        <bpmn:incoming>Flow_01</bpmn:incoming>
        <bpmn:outgoing>Flow_02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_auth" name="Запрос легитимен?">
        <bpmn:incoming>Flow_02</bpmn:incoming>
        <bpmn:outgoing>Flow_03</bpmn:outgoing>
        <bpmn:outgoing>Flow_04</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_reject" name="Вернуть 403
и зафиксировать инцидент">
        <bpmn:incoming>Flow_04</bpmn:incoming>
        <bpmn:outgoing>Flow_05</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_rejected" name="Запрос отклонён">
        <bpmn:incoming>Flow_05</bpmn:incoming>
        <bpmn:errorEventDefinition />
      </bpmn:endEvent>
      <bpmn:serviceTask id="T_extract" name="Извлечь текст:
PDF / DOCX / HL7 / FHIR">
        <bpmn:incoming>Flow_03</bpmn:incoming>
        <bpmn:outgoing>Flow_06</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_ner" name="Распознать ПДн: ФИО, даты,
адреса, СНИЛС, полис">
        <bpmn:incoming>Flow_06</bpmn:incoming>
        <bpmn:outgoing>Flow_07</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_classify" name="Классифицировать по ФЗ-152
и HIPAA Safe Harbor">
        <bpmn:incoming>Flow_07</bpmn:incoming>
        <bpmn:outgoing>Flow_08</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_conf" name="Уверенность ≥ порога?">
        <bpmn:incoming>Flow_08</bpmn:incoming>
        <bpmn:outgoing>Flow_09</bpmn:outgoing>
        <bpmn:outgoing>Flow_10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_manual" name="Верифицировать разметку
вручную">
        <bpmn:incoming>Flow_10</bpmn:incoming>
        <bpmn:outgoing>Flow_11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_mask" name="Маскировать и псевдонимизировать,
сохранить токен-мапу">
        <bpmn:incoming>Flow_09</bpmn:incoming>
        <bpmn:incoming>Flow_11</bpmn:incoming>
        <bpmn:outgoing>Flow_12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_recheck" name="Контрольный прогон:
поиск остаточных ПДн">
        <bpmn:incoming>Flow_12</bpmn:incoming>
        <bpmn:outgoing>Flow_13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_residual" name="Найдены остаточные ПДн?">
        <bpmn:incoming>Flow_13</bpmn:incoming>
        <bpmn:outgoing>Flow_14</bpmn:outgoing>
        <bpmn:outgoing>Flow_15</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_quarantine" name="Отправить в карантин
на ручную обработку">
        <bpmn:incoming>Flow_15</bpmn:incoming>
        <bpmn:outgoing>Flow_16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="End_quarantine" name="Документ в карантине">
        <bpmn:incoming>Flow_16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="T_store" name="Сохранить документ и токен-мапу
в раздельных контурах">
        <bpmn:incoming>Flow_14</bpmn:incoming>
        <bpmn:outgoing>Flow_17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_audit" name="Записать событие
в неизменяемый аудит-лог">
        <bpmn:incoming>Flow_17</bpmn:incoming>
        <bpmn:outgoing>Flow_18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="T_return" name="Вернуть обезличенный
документ в МИС">
        <bpmn:incoming>Flow_18</bpmn:incoming>
        <bpmn:outgoing>Flow_19</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="End_done" name="Документ обезличен">
        <bpmn:incoming>Flow_19</bpmn:incoming>
        <bpmn:messageEventDefinition />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_doc" targetRef="T_auth" />
      <bpmn:sequenceFlow id="Flow_02" sourceRef="T_auth" targetRef="G_auth" />
      <bpmn:sequenceFlow id="Flow_03" name="да" sourceRef="G_auth" targetRef="T_extract" />
      <bpmn:sequenceFlow id="Flow_04" name="нет" sourceRef="G_auth" targetRef="T_reject" />
      <bpmn:sequenceFlow id="Flow_05" sourceRef="T_reject" targetRef="End_rejected" />
      <bpmn:sequenceFlow id="Flow_06" sourceRef="T_extract" targetRef="T_ner" />
      <bpmn:sequenceFlow id="Flow_07" sourceRef="T_ner" targetRef="T_classify" />
      <bpmn:sequenceFlow id="Flow_08" sourceRef="T_classify" targetRef="G_conf" />
      <bpmn:sequenceFlow id="Flow_09" name="да" sourceRef="G_conf" targetRef="T_mask" />
      <bpmn:sequenceFlow id="Flow_10" name="нет" sourceRef="G_conf" targetRef="T_manual" />
      <bpmn:sequenceFlow id="Flow_11" sourceRef="T_manual" targetRef="T_mask" />
      <bpmn:sequenceFlow id="Flow_12" sourceRef="T_mask" targetRef="T_recheck" />
      <bpmn:sequenceFlow id="Flow_13" sourceRef="T_recheck" targetRef="G_residual" />
      <bpmn:sequenceFlow id="Flow_14" name="нет" sourceRef="G_residual" targetRef="T_store" />
      <bpmn:sequenceFlow id="Flow_15" name="да" sourceRef="G_residual" targetRef="T_quarantine" />
      <bpmn:sequenceFlow id="Flow_16" sourceRef="T_quarantine" targetRef="End_quarantine" />
      <bpmn:sequenceFlow id="Flow_17" sourceRef="T_store" targetRef="T_audit" />
      <bpmn:sequenceFlow id="Flow_18" sourceRef="T_audit" targetRef="T_return" />
      <bpmn:sequenceFlow id="Flow_19" sourceRef="T_return" targetRef="End_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_phi_anonymization">
    <bpmndi:BPMNPlane id="Plane_phi_anonymization" bpmnElement="Collaboration_phi_anonymization">
      <bpmndi:BPMNShape id="Shape_Participant_phi_anonymization" bpmnElement="Participant_phi_anonymization" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2920" height="1160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_mis" bpmnElement="Lane_mis" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2890" height="180" />
