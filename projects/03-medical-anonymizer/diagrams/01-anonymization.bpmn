        <di:waypoint x="2660" y="350" />
        <di:waypoint x="2695" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_19" bpmnElement="Flow_19">
        <di:waypoint x="2815" y="350" />
        <di:waypoint x="2871" y="350" />
        <di:waypoint x="2871" y="170" />
        <di:waypoint x="2927" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
