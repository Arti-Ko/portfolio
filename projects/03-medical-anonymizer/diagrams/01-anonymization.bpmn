        <di:waypoint x="1745" y="660" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1725" y="636" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1450" y="660" />
