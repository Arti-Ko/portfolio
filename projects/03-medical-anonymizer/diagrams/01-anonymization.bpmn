      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_store" bpmnElement="T_store">
        <dc:Bounds x="2315" y="1110" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_audit" bpmnElement="T_audit">
        <dc:Bounds x="2505" y="1110" width="120" height="80" />
      </bpmndi:BPMNShape>
