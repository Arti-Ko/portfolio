<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_symptom_tracking"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="portfolio/tools/bpmn_gen.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_symptom_tracking">
    <bpmn:participant id="Participant_symptom_tracking" name="Трекер симптомов онкопациента" processRef="Process_symptom_tracking" />
  </bpmn:collaboration>
  <bpmn:process id="Process_symptom_tracking" name="Ежедневный учёт симптомов и эскалация" isExecutable="false">
    <bpmn:documentation>Пациент отмечает симптомы по шкале, система оценивает тяжесть и решает, достаточно ли рекомендации по самопомощи или нужно поднять флаг лечащему врачу.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_symptom_tracking">
      <bpmn:lane id="Lane_pat" name="Пациент">
        <bpmn:flowNodeRef>Start_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_app" name="Приложение">
        <bpmn:flowNodeRef>T_template</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_advice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_store</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_rules" name="Модуль оценки">
        <bpmn:flowNodeRef>T_grade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_severity</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_doc" name="Лечащий врач">
        <bpmn:flowNodeRef>T_notify_doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_mark</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Start_open" name="Пациент открыл
дневник">
        <bpmn:outgoing>Flow_01</bpmn:outgoing>
        <bpmn:messageEventDefinition />
      </bpmn:startEvent>
      <bpmn:userTask id="T_log" name="Отметить симптомы
по шкале">
        <bpmn:incoming>Flow_01</bpmn:incoming>
        <bpmn:outgoing>Flow_02</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_template" name="Подставить шаблон
по нозологии">
        <bpmn:incoming>Flow_02</bpmn:incoming>
        <bpmn:outgoing>Flow_03</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_grade" name="Оценить степень тяжести
по клинической шкале">
        <bpmn:incoming>Flow_03</bpmn:incoming>
        <bpmn:outgoing>Flow_04</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_severity" name="Тяжесть
выше порога?">
        <bpmn:incoming>Flow_04</bpmn:incoming>
        <bpmn:outgoing>Flow_05</bpmn:outgoing>
        <bpmn:outgoing>Flow_06</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="T_advice" name="Показать рекомендацию
по самопомощи">
        <bpmn:incoming>Flow_05</bpmn:incoming>
        <bpmn:outgoing>Flow_11</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="T_notify_doc" name="Поднять флаг
лечащему врачу">
        <bpmn:incoming>Flow_06</bpmn:incoming>
        <bpmn:outgoing>Flow_07</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="T_review" name="Посмотреть динамику
симптомов">
        <bpmn:incoming>Flow_07</bpmn:incoming>
        <bpmn:outgoing>Flow_08</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_action" name="Требуется
вмешательство?">
        <bpmn:incoming>Flow_08</bpmn:incoming>
        <bpmn:outgoing>Flow_09</bpmn:outgoing>
        <bpmn:outgoing>Flow_10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="T_contact" name="Связаться с пациентом
и скорректировать терапию">
        <bpmn:incoming>Flow_09</bpmn:incoming>
        <bpmn:outgoing>Flow_12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_mark" name="Отметить
как наблюдение">
        <bpmn:incoming>Flow_10</bpmn:incoming>
        <bpmn:outgoing>Flow_13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_store" name="Сохранить запись
в дневнике">
        <bpmn:incoming>Flow_11</bpmn:incoming>
        <bpmn:incoming>Flow_12</bpmn:incoming>
        <bpmn:incoming>Flow_13</bpmn:incoming>
        <bpmn:outgoing>Flow_14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_done" name="Запись сохранена">
        <bpmn:incoming>Flow_14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_open" targetRef="T_log" />
      <bpmn:sequenceFlow id="Flow_02" sourceRef="T_log" targetRef="T_template" />
      <bpmn:sequenceFlow id="Flow_03" sourceRef="T_template" targetRef="T_grade" />
      <bpmn:sequenceFlow id="Flow_04" sourceRef="T_grade" targetRef="G_severity" />
      <bpmn:sequenceFlow id="Flow_05" name="нет" sourceRef="G_severity" targetRef="T_advice" />
      <bpmn:sequenceFlow id="Flow_06" name="да" sourceRef="G_severity" targetRef="T_notify_doc" />
      <bpmn:sequenceFlow id="Flow_07" sourceRef="T_notify_doc" targetRef="T_review" />
      <bpmn:sequenceFlow id="Flow_08" sourceRef="T_review" targetRef="G_action" />
      <bpmn:sequenceFlow id="Flow_09" name="да" sourceRef="G_action" targetRef="T_contact" />
      <bpmn:sequenceFlow id="Flow_10" name="нет" sourceRef="G_action" targetRef="T_mark" />
      <bpmn:sequenceFlow id="Flow_11" sourceRef="T_advice" targetRef="T_store" />
      <bpmn:sequenceFlow id="Flow_12" sourceRef="T_contact" targetRef="T_store" />
      <bpmn:sequenceFlow id="Flow_13" sourceRef="T_mark" targetRef="T_store" />
      <bpmn:sequenceFlow id="Flow_14" sourceRef="T_store" targetRef="End_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_symptom_tracking">
    <bpmndi:BPMNPlane id="Plane_symptom_tracking" bpmnElement="Collaboration_symptom_tracking">
      <bpmndi:BPMNShape id="Shape_Participant_symptom_tracking" bpmnElement="Participant_symptom_tracking" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2160" height="850" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_pat" bpmnElement="Lane_pat" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2130" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_app" bpmnElement="Lane_app" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="2130" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_rules" bpmnElement="Lane_rules" isHorizontal="true">
        <dc:Bounds x="190" y="440" width="2130" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_doc" bpmnElement="Lane_doc" isHorizontal="true">
        <dc:Bounds x="190" y="620" width="2130" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_open" bpmnElement="Start_open">
        <dc:Bounds x="267" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="232" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_log" bpmnElement="T_log">
        <dc:Bounds x="415" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_template" bpmnElement="T_template">
        <dc:Bounds x="605" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_grade" bpmnElement="T_grade">
        <dc:Bounds x="795" y="490" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_severity" bpmnElement="G_severity">
        <dc:Bounds x="1020" y="505" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="985" y="561" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_advice" bpmnElement="T_advice">
        <dc:Bounds x="1175" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_notify_doc" bpmnElement="T_notify_doc">
        <dc:Bounds x="1175" y="670" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_review" bpmnElement="T_review">
        <dc:Bounds x="1365" y="670" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_action" bpmnElement="G_action">
        <dc:Bounds x="1590" y="685" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1555" y="741" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_contact" bpmnElement="T_contact">
        <dc:Bounds x="1745" y="670" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_mark" bpmnElement="T_mark">
        <dc:Bounds x="1745" y="800" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_store" bpmnElement="T_store">
        <dc:Bounds x="1935" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_done" bpmnElement="End_done">
        <dc:Bounds x="2167" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2132" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="303" y="170" />
        <di:waypoint x="415" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="535" y="170" />
        <di:waypoint x="570" y="170" />
        <di:waypoint x="570" y="350" />
        <di:waypoint x="605" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03">
        <di:waypoint x="725" y="350" />
        <di:waypoint x="760" y="350" />
        <di:waypoint x="760" y="530" />
        <di:waypoint x="795" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04">
        <di:waypoint x="915" y="530" />
        <di:waypoint x="1020" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="1070" y="530" />
        <di:waypoint x="1122" y="530" />
        <di:waypoint x="1122" y="350" />
        <di:waypoint x="1175" y="350" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1102" y="326" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="1070" y="530" />
        <di:waypoint x="1122" y="530" />
        <di:waypoint x="1122" y="710" />
        <di:waypoint x="1175" y="710" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1102" y="686" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07" bpmnElement="Flow_07">
        <di:waypoint x="1295" y="710" />
        <di:waypoint x="1365" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08">
        <di:waypoint x="1485" y="710" />
        <di:waypoint x="1590" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09" bpmnElement="Flow_09">
        <di:waypoint x="1640" y="710" />
        <di:waypoint x="1745" y="710" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1725" y="686" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1640" y="710" />
        <di:waypoint x="1692" y="710" />
        <di:waypoint x="1692" y="840" />
        <di:waypoint x="1745" y="840" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1672" y="816" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1295" y="350" />
        <di:waypoint x="1935" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="1865" y="710" />
        <di:waypoint x="1900" y="710" />
        <di:waypoint x="1900" y="350" />
        <di:waypoint x="1935" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13">
        <di:waypoint x="1865" y="840" />
        <di:waypoint x="1900" y="840" />
        <di:waypoint x="1900" y="350" />
        <di:waypoint x="1935" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_14" bpmnElement="Flow_14">
        <di:waypoint x="2055" y="350" />
        <di:waypoint x="2111" y="350" />
        <di:waypoint x="2111" y="170" />
        <di:waypoint x="2167" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
