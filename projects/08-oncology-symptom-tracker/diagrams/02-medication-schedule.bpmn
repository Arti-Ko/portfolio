<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_medication_schedule"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="sa-portfolio/tools/bpmn_gen.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_medication_schedule">
    <bpmn:participant id="Participant_medication_schedule" name="Напоминания и учёт приверженности терапии" processRef="Process_medication_schedule" />
  </bpmn:collaboration>
  <bpmn:process id="Process_medication_schedule" name="Календарь приёма препаратов" isExecutable="false">
    <bpmn:documentation>Схема приёма превращается в календарь с напоминаниями. Пропуски фиксируются и при накоплении становятся сигналом врачу: низкая приверженность терапии — клинически значимый факт.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_medication_schedule">
      <bpmn:lane id="Lane_doc" name="Лечащий врач">
        <bpmn:flowNodeRef>Start_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_flag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_flagged</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_app" name="Приложение">
        <bpmn:flowNodeRef>T_schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_taken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_mark_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_miss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_stats</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_adherence</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_sched" name="Планировщик">
        <bpmn:flowNodeRef>T_tick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_repeat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_wait</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_pat" name="Пациент">
        <bpmn:flowNodeRef>T_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Start_plan" name="Врач назначил
схему приёма">
        <bpmn:outgoing>Flow_01</bpmn:outgoing>
        <bpmn:messageEventDefinition />
      </bpmn:startEvent>
      <bpmn:serviceTask id="T_schedule" name="Построить календарь
приёмов">
        <bpmn:incoming>Flow_01</bpmn:incoming>
        <bpmn:outgoing>Flow_02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_tick" name="Отследить наступление
времени приёма">
        <bpmn:incoming>Flow_02</bpmn:incoming>
        <bpmn:outgoing>Flow_03</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="T_remind" name="Отправить
напоминание">
        <bpmn:incoming>Flow_03</bpmn:incoming>
        <bpmn:outgoing>Flow_04</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="T_confirm" name="Отметить приём
препарата">
        <bpmn:incoming>Flow_04</bpmn:incoming>
        <bpmn:outgoing>Flow_05</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_taken" name="Приём
подтверждён?">
        <bpmn:incoming>Flow_05</bpmn:incoming>
        <bpmn:outgoing>Flow_06</bpmn:outgoing>
        <bpmn:outgoing>Flow_07</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_mark_ok" name="Зафиксировать приём">
        <bpmn:incoming>Flow_06</bpmn:incoming>
        <bpmn:outgoing>Flow_10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="T_repeat" name="Повторить напоминание
в пределах окна">
        <bpmn:incoming>Flow_07</bpmn:incoming>
        <bpmn:outgoing>Flow_08</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:serviceTask id="T_wait" name="Дождаться конца
окна приёма">
        <bpmn:incoming>Flow_08</bpmn:incoming>
        <bpmn:outgoing>Flow_09</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_miss" name="Зафиксировать пропуск
и показать инструкцию">
        <bpmn:incoming>Flow_09</bpmn:incoming>
        <bpmn:outgoing>Flow_11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_stats" name="Обновить статистику
приверженности">
        <bpmn:incoming>Flow_10</bpmn:incoming>
        <bpmn:incoming>Flow_11</bpmn:incoming>
        <bpmn:outgoing>Flow_12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_adherence" name="Приверженность
ниже порога?">
        <bpmn:incoming>Flow_12</bpmn:incoming>
        <bpmn:outgoing>Flow_13</bpmn:outgoing>
        <bpmn:outgoing>Flow_14</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="T_flag" name="Показать врачу сигнал
о систематических пропусках">
        <bpmn:incoming>Flow_13</bpmn:incoming>
        <bpmn:outgoing>Flow_15</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="End_flagged" name="Врач уведомлён">
        <bpmn:incoming>Flow_15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_ok" name="Календарь актуален">
        <bpmn:incoming>Flow_14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_plan" targetRef="T_schedule" />
      <bpmn:sequenceFlow id="Flow_02" sourceRef="T_schedule" targetRef="T_tick" />
      <bpmn:sequenceFlow id="Flow_03" sourceRef="T_tick" targetRef="T_remind" />
      <bpmn:sequenceFlow id="Flow_04" sourceRef="T_remind" targetRef="T_confirm" />
      <bpmn:sequenceFlow id="Flow_05" sourceRef="T_confirm" targetRef="G_taken" />
      <bpmn:sequenceFlow id="Flow_06" name="да" sourceRef="G_taken" targetRef="T_mark_ok" />
      <bpmn:sequenceFlow id="Flow_07" name="нет" sourceRef="G_taken" targetRef="T_repeat" />
      <bpmn:sequenceFlow id="Flow_08" sourceRef="T_repeat" targetRef="T_wait" />
      <bpmn:sequenceFlow id="Flow_09" sourceRef="T_wait" targetRef="T_miss" />
      <bpmn:sequenceFlow id="Flow_10" sourceRef="T_mark_ok" targetRef="T_stats" />
      <bpmn:sequenceFlow id="Flow_11" sourceRef="T_miss" targetRef="T_stats" />
      <bpmn:sequenceFlow id="Flow_12" sourceRef="T_stats" targetRef="G_adherence" />
      <bpmn:sequenceFlow id="Flow_13" name="да" sourceRef="G_adherence" targetRef="T_flag" />
      <bpmn:sequenceFlow id="Flow_14" name="нет" sourceRef="G_adherence" targetRef="End_ok" />
      <bpmn:sequenceFlow id="Flow_15" sourceRef="T_flag" targetRef="End_flagged" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_medication_schedule">
    <bpmndi:BPMNPlane id="Plane_medication_schedule" bpmnElement="Collaboration_medication_schedule">
      <bpmndi:BPMNShape id="Shape_Participant_medication_schedule" bpmnElement="Participant_medication_schedule" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2540" height="980" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_doc" bpmnElement="Lane_doc" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2510" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_app" bpmnElement="Lane_app" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="2510" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_sched" bpmnElement="Lane_sched" isHorizontal="true">
        <dc:Bounds x="190" y="570" width="2510" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_pat" bpmnElement="Lane_pat" isHorizontal="true">
        <dc:Bounds x="190" y="880" width="2510" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_plan" bpmnElement="Start_plan">
        <dc:Bounds x="267" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="232" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_schedule" bpmnElement="T_schedule">
        <dc:Bounds x="415" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_tick" bpmnElement="T_tick">
        <dc:Bounds x="605" y="620" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_remind" bpmnElement="T_remind">
        <dc:Bounds x="795" y="620" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_confirm" bpmnElement="T_confirm">
        <dc:Bounds x="985" y="930" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_taken" bpmnElement="G_taken">
        <dc:Bounds x="1210" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1175" y="381" width="120" height="27" />
