        <dc:Bounds x="1745" y="440" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_stats" bpmnElement="T_stats">
        <dc:Bounds x="1935" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_adherence" bpmnElement="G_adherence">
