        <dc:Bounds x="2315" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_flagged" bpmnElement="End_flagged">
        <dc:Bounds x="2547" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2512" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_ok" bpmnElement="End_ok">
        <dc:Bounds x="2357" y="952" width="36" height="36" />
