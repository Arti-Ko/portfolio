<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_driver_clearance"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="portfolio/tools/bpmn_gen.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_driver_clearance">
    <bpmn:participant id="Participant_driver_clearance" name="Допуск кандидата к работе на транспорте" processRef="Process_driver_clearance" />
  </bpmn:collaboration>
  <bpmn:process id="Process_driver_clearance" name="Медконтроль и проверка безопасности дорожного движения" isExecutable="false">
    <bpmn:documentation>Дополнительный контур для логистического направления. Медицинское заключение и профиль нарушений проверяются до открытия доступа к сменам, а не после первого рейса.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_driver_clearance">
      <bpmn:lane id="Lane_cand" name="Кандидат">
        <bpmn:flowNodeRef>Start_bdd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_portal" name="Портал найма">
        <bpmn:flowNodeRef>T_book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_med</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_med_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_med_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_grant</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_med" name="Медицинский партнёр">
        <bpmn:flowNodeRef>T_result</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bdd" name="Специалист БДД">
        <bpmn:flowNodeRef>T_license</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_violations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_bdd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_bdd_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_bdd_no</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_sb" name="Служба безопасности">
        <bpmn:flowNodeRef>T_final</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Start_bdd" name="Кандидат направлен
на допуск">
        <bpmn:outgoing>Flow_01</bpmn:outgoing>
        <bpmn:messageEventDefinition />
      </bpmn:startEvent>
      <bpmn:serviceTask id="T_book" name="Записать на медосмотр
в партнёрской сети">
        <bpmn:incoming>Flow_01</bpmn:incoming>
        <bpmn:outgoing>Flow_02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="T_visit" name="Пройти медосмотр">
        <bpmn:incoming>Flow_02</bpmn:incoming>
        <bpmn:outgoing>Flow_03</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_result" name="Передать заключение
в портал">
        <bpmn:incoming>Flow_03</bpmn:incoming>
        <bpmn:outgoing>Flow_04</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_med" name="Заключение
положительное?">
        <bpmn:incoming>Flow_04</bpmn:incoming>
        <bpmn:outgoing>Flow_05</bpmn:outgoing>
        <bpmn:outgoing>Flow_06</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="T_med_no" name="Зафиксировать отказ
по медицинским основаниям">
        <bpmn:incoming>Flow_06</bpmn:incoming>
        <bpmn:outgoing>Flow_07</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="End_med_no" name="Допуск не выдан">
        <bpmn:incoming>Flow_07</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="T_license" name="Проверить удостоверение
и стаж">
        <bpmn:incoming>Flow_05</bpmn:incoming>
        <bpmn:outgoing>Flow_08</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_violations" name="Запросить историю
нарушений">
        <bpmn:incoming>Flow_08</bpmn:incoming>
        <bpmn:outgoing>Flow_09</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_bdd" name="Профиль риска
допустим?">
        <bpmn:incoming>Flow_09</bpmn:incoming>
        <bpmn:outgoing>Flow_10</bpmn:outgoing>
        <bpmn:outgoing>Flow_11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="T_bdd_no" name="Отказать в допуске
к управлению">
        <bpmn:incoming>Flow_11</bpmn:incoming>
        <bpmn:outgoing>Flow_12</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="End_bdd_no" name="Допуск
к транспорту закрыт">
        <bpmn:incoming>Flow_12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="T_final" name="Согласовать допуск">
        <bpmn:incoming>Flow_10</bpmn:incoming>
        <bpmn:outgoing>Flow_13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_grant" name="Открыть доступ к сменам
и оформить трудоустройство">
        <bpmn:incoming>Flow_13</bpmn:incoming>
        <bpmn:outgoing>Flow_14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_ok" name="Кандидат допущен
к работе">
        <bpmn:incoming>Flow_14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_bdd" targetRef="T_book" />
      <bpmn:sequenceFlow id="Flow_02" sourceRef="T_book" targetRef="T_visit" />
      <bpmn:sequenceFlow id="Flow_03" sourceRef="T_visit" targetRef="T_result" />
      <bpmn:sequenceFlow id="Flow_04" sourceRef="T_result" targetRef="G_med" />
      <bpmn:sequenceFlow id="Flow_05" name="да" sourceRef="G_med" targetRef="T_license" />
      <bpmn:sequenceFlow id="Flow_06" name="нет" sourceRef="G_med" targetRef="T_med_no" />
      <bpmn:sequenceFlow id="Flow_07" sourceRef="T_med_no" targetRef="End_med_no" />
      <bpmn:sequenceFlow id="Flow_08" sourceRef="T_license" targetRef="T_violations" />
      <bpmn:sequenceFlow id="Flow_09" sourceRef="T_violations" targetRef="G_bdd" />
      <bpmn:sequenceFlow id="Flow_10" name="да" sourceRef="G_bdd" targetRef="T_final" />
      <bpmn:sequenceFlow id="Flow_11" name="нет" sourceRef="G_bdd" targetRef="T_bdd_no" />
      <bpmn:sequenceFlow id="Flow_12" sourceRef="T_bdd_no" targetRef="End_bdd_no" />
      <bpmn:sequenceFlow id="Flow_13" sourceRef="T_final" targetRef="T_grant" />
      <bpmn:sequenceFlow id="Flow_14" sourceRef="T_grant" targetRef="End_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_driver_clearance">
    <bpmndi:BPMNPlane id="Plane_driver_clearance" bpmnElement="Collaboration_driver_clearance">
      <bpmndi:BPMNShape id="Shape_Participant_driver_clearance" bpmnElement="Participant_driver_clearance" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2160" height="1160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_cand" bpmnElement="Lane_cand" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2130" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_portal" bpmnElement="Lane_portal" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="2130" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_med" bpmnElement="Lane_med" isHorizontal="true">
        <dc:Bounds x="190" y="570" width="2130" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_bdd" bpmnElement="Lane_bdd" isHorizontal="true">
        <dc:Bounds x="190" y="750" width="2130" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_sb" bpmnElement="Lane_sb" isHorizontal="true">
        <dc:Bounds x="190" y="1060" width="2130" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_bdd" bpmnElement="Start_bdd">
        <dc:Bounds x="267" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="232" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_book" bpmnElement="T_book">
        <dc:Bounds x="415" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_visit" bpmnElement="T_visit">
        <dc:Bounds x="605" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_result" bpmnElement="T_result">
        <dc:Bounds x="795" y="620" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_med" bpmnElement="G_med">
        <dc:Bounds x="1020" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="985" y="381" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_med_no" bpmnElement="T_med_no">
        <dc:Bounds x="1175" y="440" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_med_no" bpmnElement="End_med_no">
        <dc:Bounds x="1407" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1372" y="504" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_license" bpmnElement="T_license">
        <dc:Bounds x="1175" y="800" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_violations" bpmnElement="T_violations">
        <dc:Bounds x="1365" y="800" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_bdd" bpmnElement="G_bdd">
        <dc:Bounds x="1590" y="815" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1555" y="871" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_bdd_no" bpmnElement="T_bdd_no">
        <dc:Bounds x="1745" y="930" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_bdd_no" bpmnElement="End_bdd_no">
        <dc:Bounds x="1977" y="952" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1942" y="994" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_final" bpmnElement="T_final">
        <dc:Bounds x="1745" y="1110" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_grant" bpmnElement="T_grant">
        <dc:Bounds x="1935" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_ok" bpmnElement="End_ok">
        <dc:Bounds x="2167" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2132" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="303" y="170" />
        <di:waypoint x="359" y="170" />
        <di:waypoint x="359" y="350" />
        <di:waypoint x="415" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="535" y="350" />
        <di:waypoint x="570" y="350" />
        <di:waypoint x="570" y="170" />
        <di:waypoint x="605" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03">
        <di:waypoint x="725" y="170" />
        <di:waypoint x="760" y="170" />
        <di:waypoint x="760" y="660" />
        <di:waypoint x="795" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04">
        <di:waypoint x="915" y="660" />
        <di:waypoint x="967" y="660" />
        <di:waypoint x="967" y="350" />
        <di:waypoint x="1020" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="1070" y="350" />
        <di:waypoint x="1122" y="350" />
        <di:waypoint x="1122" y="840" />
        <di:waypoint x="1175" y="840" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1102" y="816" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="1070" y="350" />
        <di:waypoint x="1122" y="350" />
        <di:waypoint x="1122" y="480" />
        <di:waypoint x="1175" y="480" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1102" y="456" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07" bpmnElement="Flow_07">
        <di:waypoint x="1295" y="480" />
        <di:waypoint x="1407" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08">
        <di:waypoint x="1295" y="840" />
        <di:waypoint x="1365" y="840" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09" bpmnElement="Flow_09">
        <di:waypoint x="1485" y="840" />
        <di:waypoint x="1590" y="840" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1640" y="840" />
        <di:waypoint x="1692" y="840" />
        <di:waypoint x="1692" y="1150" />
        <di:waypoint x="1745" y="1150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1672" y="1126" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1640" y="840" />
        <di:waypoint x="1692" y="840" />
        <di:waypoint x="1692" y="970" />
        <di:waypoint x="1745" y="970" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1672" y="946" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="1865" y="970" />
        <di:waypoint x="1977" y="970" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13">
        <di:waypoint x="1865" y="1150" />
        <di:waypoint x="1900" y="1150" />
        <di:waypoint x="1900" y="350" />
        <di:waypoint x="1935" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_14" bpmnElement="Flow_14">
        <di:waypoint x="2055" y="350" />
        <di:waypoint x="2111" y="350" />
        <di:waypoint x="2111" y="170" />
        <di:waypoint x="2167" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
