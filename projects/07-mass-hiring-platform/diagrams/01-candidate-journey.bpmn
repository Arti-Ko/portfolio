<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_candidate_journey"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="portfolio/tools/bpmn_gen.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_candidate_journey">
    <bpmn:participant id="Participant_candidate_journey" name="Массовый найм самозанятых и ИП" processRef="Process_candidate_journey" />
  </bpmn:collaboration>
  <bpmn:process id="Process_candidate_journey" name="Путь кандидата от анкеты до трудоустройства" isExecutable="false">
    <bpmn:documentation>Единая воронка для тысяч кандидатов с проверкой налогового статуса и службы безопасности. Логистическое направление уходит в дополнительный контур допуска.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_candidate_journey">
      <bpmn:lane id="Lane_cand" name="Кандидат">
        <bpmn:flowNodeRef>Start_apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_personal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_pass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_hired</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_portal" name="Портал найма">
        <bpmn:flowNodeRef>T_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_hire</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_checks" name="Проверки">
        <bpmn:flowNodeRef>T_fns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_help</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_sb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_hr" name="HR и руководитель">
        <bpmn:flowNodeRef>G_branch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_bdd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_to_med</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ext" name="Внешние системы">
        <bpmn:flowNodeRef>T_sync</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Start_apply" name="Кандидат
открыл анкету">
        <bpmn:outgoing>Flow_01</bpmn:outgoing>
        <bpmn:messageEventDefinition />
      </bpmn:startEvent>
      <bpmn:userTask id="T_personal" name="Заполнить
персональные данные">
        <bpmn:incoming>Flow_01</bpmn:incoming>
        <bpmn:outgoing>Flow_02</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T_form" name="Выбрать форму занятости:
самозанятый или ИП">
        <bpmn:incoming>Flow_02</bpmn:incoming>
        <bpmn:outgoing>Flow_03</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="T_docs" name="Запросить документы
по выбранной форме">
        <bpmn:incoming>Flow_03</bpmn:incoming>
        <bpmn:outgoing>Flow_04</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="T_upload" name="Загрузить документы">
        <bpmn:incoming>Flow_04</bpmn:incoming>
        <bpmn:outgoing>Flow_05</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_fns" name="Проверить налоговый статус
в ФНС">
        <bpmn:incoming>Flow_05</bpmn:incoming>
        <bpmn:outgoing>Flow_06</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_status" name="Статус
подтверждён?">
        <bpmn:incoming>Flow_06</bpmn:incoming>
        <bpmn:outgoing>Flow_07</bpmn:outgoing>
        <bpmn:outgoing>Flow_08</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="T_help" name="Показать инструкцию
по регистрации статуса">
        <bpmn:incoming>Flow_08</bpmn:incoming>
        <bpmn:outgoing>Flow_09</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="End_pending" name="Кандидат вне воронки
до регистрации">
        <bpmn:incoming>Flow_09</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="T_sb" name="Проверка
службы безопасности">
        <bpmn:incoming>Flow_07</bpmn:incoming>
        <bpmn:outgoing>Flow_10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_sb" name="Проверка
пройдена?">
        <bpmn:incoming>Flow_10</bpmn:incoming>
        <bpmn:outgoing>Flow_11</bpmn:outgoing>
        <bpmn:outgoing>Flow_12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="T_reject" name="Отказать
с фиксацией причины">
        <bpmn:incoming>Flow_12</bpmn:incoming>
        <bpmn:outgoing>Flow_13</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="End_rejected" name="Кандидат отклонён">
        <bpmn:incoming>Flow_13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sendTask id="T_test" name="Выдать тест
и назначить собеседование">
        <bpmn:incoming>Flow_11</bpmn:incoming>
        <bpmn:outgoing>Flow_14</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="T_pass" name="Пройти тест
и собеседование">
        <bpmn:incoming>Flow_14</bpmn:incoming>
        <bpmn:outgoing>Flow_15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_branch" name="Логистическое
направление?">
        <bpmn:incoming>Flow_15</bpmn:incoming>
        <bpmn:outgoing>Flow_16</bpmn:outgoing>
        <bpmn:outgoing>Flow_17</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="T_bdd" name="Направить на медконтроль
и проверку БДД">
        <bpmn:incoming>Flow_17</bpmn:incoming>
        <bpmn:outgoing>Flow_18</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="End_to_med" name="Передано
в контур допуска">
        <bpmn:incoming>Flow_18</bpmn:incoming>
        <bpmn:messageEventDefinition />
      </bpmn:endEvent>
      <bpmn:serviceTask id="T_hire" name="Оформить
трудоустройство">
        <bpmn:incoming>Flow_16</bpmn:incoming>
        <bpmn:outgoing>Flow_19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_sync" name="Синхронизировать
с CRM и шиной событий">
        <bpmn:incoming>Flow_19</bpmn:incoming>
        <bpmn:outgoing>Flow_20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_hired" name="Кандидат
трудоустроен">
        <bpmn:incoming>Flow_20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_apply" targetRef="T_personal" />
      <bpmn:sequenceFlow id="Flow_02" sourceRef="T_personal" targetRef="T_form" />
      <bpmn:sequenceFlow id="Flow_03" sourceRef="T_form" targetRef="T_docs" />
      <bpmn:sequenceFlow id="Flow_04" sourceRef="T_docs" targetRef="T_upload" />
      <bpmn:sequenceFlow id="Flow_05" sourceRef="T_upload" targetRef="T_fns" />
      <bpmn:sequenceFlow id="Flow_06" sourceRef="T_fns" targetRef="G_status" />
      <bpmn:sequenceFlow id="Flow_07" name="да" sourceRef="G_status" targetRef="T_sb" />
      <bpmn:sequenceFlow id="Flow_08" name="нет" sourceRef="G_status" targetRef="T_help" />
      <bpmn:sequenceFlow id="Flow_09" sourceRef="T_help" targetRef="End_pending" />
      <bpmn:sequenceFlow id="Flow_10" sourceRef="T_sb" targetRef="G_sb" />
      <bpmn:sequenceFlow id="Flow_11" name="да" sourceRef="G_sb" targetRef="T_test" />
      <bpmn:sequenceFlow id="Flow_12" name="нет" sourceRef="G_sb" targetRef="T_reject" />
      <bpmn:sequenceFlow id="Flow_13" sourceRef="T_reject" targetRef="End_rejected" />
      <bpmn:sequenceFlow id="Flow_14" sourceRef="T_test" targetRef="T_pass" />
      <bpmn:sequenceFlow id="Flow_15" sourceRef="T_pass" targetRef="G_branch" />
      <bpmn:sequenceFlow id="Flow_16" name="нет" sourceRef="G_branch" targetRef="T_hire" />
      <bpmn:sequenceFlow id="Flow_17" name="да" sourceRef="G_branch" targetRef="T_bdd" />
      <bpmn:sequenceFlow id="Flow_18" sourceRef="T_bdd" targetRef="End_to_med" />
      <bpmn:sequenceFlow id="Flow_19" sourceRef="T_hire" targetRef="T_sync" />
      <bpmn:sequenceFlow id="Flow_20" sourceRef="T_sync" targetRef="End_hired" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_candidate_journey">
    <bpmndi:BPMNPlane id="Plane_candidate_journey" bpmnElement="Collaboration_candidate_journey">
