<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_voyage_tracking"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="portfolio/tools/bpmn_gen.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_voyage_tracking">
    <bpmn:participant id="Participant_voyage_tracking" name="ЭТП: исполнение перевозки" processRef="Process_voyage_tracking" />
  </bpmn:collaboration>
  <bpmn:process id="Process_voyage_tracking" name="Рейс и безбумажное закрытие сделки" isExecutable="false">
    <bpmn:documentation>От погрузки до закрытия сделки без единого бумажного документа. Положение судна приходит по AIS, юридически значимые документы подписываются электронной подписью.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_voyage_tracking">
      <bpmn:lane id="Lane_ship" name="Судовладелец">
        <bpmn:flowNodeRef>Start_load</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_port" name="Порт и терминал">
        <bpmn:flowNodeRef>T_slot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_act</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_etp" name="ЭТП">
        <bpmn:flowNodeRef>T_bol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_dev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_close</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ext" name="AIS и электронная подпись">
        <bpmn:flowNodeRef>T_sign_bol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ais</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sign_act</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_cargo" name="Грузовладелец">
        <bpmn:flowNodeRef>T_watch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Start_load" name="Судно подано
под погрузку">
        <bpmn:outgoing>Flow_01</bpmn:outgoing>
        <bpmn:messageEventDefinition />
      </bpmn:startEvent>
      <bpmn:userTask id="T_slot" name="Подтвердить слот
и начать погрузку">
        <bpmn:incoming>Flow_01</bpmn:incoming>
        <bpmn:outgoing>Flow_02</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_bol" name="Сформировать коносамент
по факту погрузки">
        <bpmn:incoming>Flow_02</bpmn:incoming>
        <bpmn:outgoing>Flow_03</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_sign_bol" name="Подписать коносамент
электронной подписью">
        <bpmn:incoming>Flow_03</bpmn:incoming>
        <bpmn:outgoing>Flow_04</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_ais" name="Передавать координаты
судна по AIS">
        <bpmn:incoming>Flow_04</bpmn:incoming>
        <bpmn:outgoing>Flow_05</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_track" name="Обновлять положение
на карте">
        <bpmn:incoming>Flow_05</bpmn:incoming>
        <bpmn:outgoing>Flow_06</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="T_watch" name="Следить за рейсом
в личном кабинете">
        <bpmn:incoming>Flow_06</bpmn:incoming>
        <bpmn:outgoing>Flow_07</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_dev" name="Отклонение
от маршрута или срока?">
        <bpmn:incoming>Flow_07</bpmn:incoming>
        <bpmn:outgoing>Flow_08</bpmn:outgoing>
        <bpmn:outgoing>Flow_09</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="T_alert" name="Уведомить стороны
и зафиксировать событие">
        <bpmn:incoming>Flow_09</bpmn:incoming>
        <bpmn:outgoing>Flow_10</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="T_arrive" name="Принять судно
и разгрузить">
        <bpmn:incoming>Flow_08</bpmn:incoming>
        <bpmn:incoming>Flow_10</bpmn:incoming>
        <bpmn:outgoing>Flow_11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="T_act" name="Сформировать акт
приёма-передачи">
        <bpmn:incoming>Flow_11</bpmn:incoming>
        <bpmn:outgoing>Flow_12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_sign_act" name="Подписать акт
электронной подписью">
        <bpmn:incoming>Flow_12</bpmn:incoming>
        <bpmn:outgoing>Flow_13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_close" name="Закрыть сделку
и обновить рейтинги">
        <bpmn:incoming>Flow_13</bpmn:incoming>
        <bpmn:outgoing>Flow_14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_done" name="Перевозка закрыта
без бумаги">
        <bpmn:incoming>Flow_14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_load" targetRef="T_slot" />
      <bpmn:sequenceFlow id="Flow_02" sourceRef="T_slot" targetRef="T_bol" />
      <bpmn:sequenceFlow id="Flow_03" sourceRef="T_bol" targetRef="T_sign_bol" />
      <bpmn:sequenceFlow id="Flow_04" sourceRef="T_sign_bol" targetRef="T_ais" />
      <bpmn:sequenceFlow id="Flow_05" sourceRef="T_ais" targetRef="T_track" />
      <bpmn:sequenceFlow id="Flow_06" sourceRef="T_track" targetRef="T_watch" />
      <bpmn:sequenceFlow id="Flow_07" sourceRef="T_watch" targetRef="G_dev" />
      <bpmn:sequenceFlow id="Flow_08" name="нет" sourceRef="G_dev" targetRef="T_arrive" />
      <bpmn:sequenceFlow id="Flow_09" name="да" sourceRef="G_dev" targetRef="T_alert" />
      <bpmn:sequenceFlow id="Flow_10" sourceRef="T_alert" targetRef="T_arrive" />
      <bpmn:sequenceFlow id="Flow_11" sourceRef="T_arrive" targetRef="T_act" />
      <bpmn:sequenceFlow id="Flow_12" sourceRef="T_act" targetRef="T_sign_act" />
      <bpmn:sequenceFlow id="Flow_13" sourceRef="T_sign_act" targetRef="T_close" />
      <bpmn:sequenceFlow id="Flow_14" sourceRef="T_close" targetRef="End_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_voyage_tracking">
    <bpmndi:BPMNPlane id="Plane_voyage_tracking" bpmnElement="Collaboration_voyage_tracking">
      <bpmndi:BPMNShape id="Shape_Participant_voyage_tracking" bpmnElement="Participant_voyage_tracking" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2730" height="1030" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_ship" bpmnElement="Lane_ship" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2700" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_port" bpmnElement="Lane_port" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="2700" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_etp" bpmnElement="Lane_etp" isHorizontal="true">
        <dc:Bounds x="190" y="440" width="2700" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_ext" bpmnElement="Lane_ext" isHorizontal="true">
        <dc:Bounds x="190" y="750" width="2700" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_cargo" bpmnElement="Lane_cargo" isHorizontal="true">
        <dc:Bounds x="190" y="930" width="2700" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_load" bpmnElement="Start_load">
        <dc:Bounds x="267" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="232" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_slot" bpmnElement="T_slot">
        <dc:Bounds x="415" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_bol" bpmnElement="T_bol">
        <dc:Bounds x="605" y="490" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_sign_bol" bpmnElement="T_sign_bol">
        <dc:Bounds x="795" y="800" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_ais" bpmnElement="T_ais">
        <dc:Bounds x="985" y="800" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_track" bpmnElement="T_track">
        <dc:Bounds x="1175" y="490" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_watch" bpmnElement="T_watch">
        <dc:Bounds x="1365" y="980" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_dev" bpmnElement="G_dev">
        <dc:Bounds x="1590" y="505" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1555" y="561" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_alert" bpmnElement="T_alert">
        <dc:Bounds x="1745" y="620" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_arrive" bpmnElement="T_arrive">
        <dc:Bounds x="1935" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_act" bpmnElement="T_act">
        <dc:Bounds x="2125" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_sign_act" bpmnElement="T_sign_act">
        <dc:Bounds x="2315" y="800" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_close" bpmnElement="T_close">
        <dc:Bounds x="2505" y="490" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_done" bpmnElement="End_done">
        <dc:Bounds x="2737" y="1002" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2702" y="1044" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="303" y="170" />
        <di:waypoint x="359" y="170" />
        <di:waypoint x="359" y="350" />
        <di:waypoint x="415" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="535" y="350" />
        <di:waypoint x="570" y="350" />
        <di:waypoint x="570" y="530" />
        <di:waypoint x="605" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03">
        <di:waypoint x="725" y="530" />
        <di:waypoint x="760" y="530" />
        <di:waypoint x="760" y="840" />
        <di:waypoint x="795" y="840" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04">
        <di:waypoint x="915" y="840" />
        <di:waypoint x="985" y="840" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="1105" y="840" />
        <di:waypoint x="1140" y="840" />
        <di:waypoint x="1140" y="530" />
        <di:waypoint x="1175" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="1295" y="530" />
        <di:waypoint x="1330" y="530" />
        <di:waypoint x="1330" y="1020" />
        <di:waypoint x="1365" y="1020" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07" bpmnElement="Flow_07">
        <di:waypoint x="1485" y="1020" />
        <di:waypoint x="1537" y="1020" />
        <di:waypoint x="1537" y="530" />
        <di:waypoint x="1590" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08">
        <di:waypoint x="1640" y="530" />
        <di:waypoint x="1787" y="530" />
        <di:waypoint x="1787" y="350" />
        <di:waypoint x="1935" y="350" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1767" y="326" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09" bpmnElement="Flow_09">
        <di:waypoint x="1640" y="530" />
        <di:waypoint x="1692" y="530" />
        <di:waypoint x="1692" y="660" />
        <di:waypoint x="1745" y="660" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1672" y="636" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1865" y="660" />
        <di:waypoint x="1900" y="660" />
        <di:waypoint x="1900" y="350" />
        <di:waypoint x="1935" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="2055" y="350" />
        <di:waypoint x="2125" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="2245" y="350" />
        <di:waypoint x="2280" y="350" />
        <di:waypoint x="2280" y="840" />
        <di:waypoint x="2315" y="840" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13">
        <di:waypoint x="2435" y="840" />
        <di:waypoint x="2470" y="840" />
        <di:waypoint x="2470" y="530" />
        <di:waypoint x="2505" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_14" bpmnElement="Flow_14">
        <di:waypoint x="2625" y="530" />
        <di:waypoint x="2681" y="530" />
        <di:waypoint x="2681" y="1020" />
        <di:waypoint x="2737" y="1020" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
