          <dc:Bounds x="1175" y="381" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_admit" bpmnElement="T_admit">
        <dc:Bounds x="1365" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_refuse" bpmnElement="T_refuse">
        <dc:Bounds x="1365" y="440" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_refused" bpmnElement="End_refused">
        <dc:Bounds x="1597" y="462" width="36" height="36" />
