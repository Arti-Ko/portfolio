      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_enough" bpmnElement="G_enough">
        <dc:Bounds x="1780" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1745" y="381" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_fail" bpmnElement="T_fail">
        <dc:Bounds x="1935" y="440" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_failed" bpmnElement="End_failed">
        <dc:Bounds x="2167" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2132" y="504" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_auction" bpmnElement="T_auction">
        <dc:Bounds x="1935" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_bid" bpmnElement="T_bid">
        <dc:Bounds x="2125" y="620" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_close" bpmnElement="T_close">
        <dc:Bounds x="2315" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_contract" bpmnElement="T_contract">
        <dc:Bounds x="2505" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_sign" bpmnElement="T_sign">
        <dc:Bounds x="2695" y="800" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_register" bpmnElement="T_register">
        <dc:Bounds x="2885" y="310" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_deal" bpmnElement="End_deal">
        <dc:Bounds x="3117" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3082" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="303" y="170" />
        <di:waypoint x="415" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="535" y="170" />
        <di:waypoint x="570" y="170" />
        <di:waypoint x="570" y="350" />
        <di:waypoint x="605" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03">
        <di:waypoint x="725" y="350" />
        <di:waypoint x="760" y="350" />
        <di:waypoint x="760" y="660" />
        <di:waypoint x="795" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04">
        <di:waypoint x="915" y="660" />
        <di:waypoint x="950" y="660" />
        <di:waypoint x="950" y="350" />
        <di:waypoint x="985" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="1105" y="350" />
        <di:waypoint x="1210" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="1260" y="350" />
        <di:waypoint x="1365" y="350" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1345" y="326" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07" bpmnElement="Flow_07">
        <di:waypoint x="1260" y="350" />
        <di:waypoint x="1312" y="350" />
        <di:waypoint x="1312" y="480" />
        <di:waypoint x="1365" y="480" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1292" y="456" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08">
        <di:waypoint x="1485" y="480" />
        <di:waypoint x="1597" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09" bpmnElement="Flow_09">
        <di:waypoint x="1485" y="350" />
        <di:waypoint x="1780" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1830" y="350" />
        <di:waypoint x="1935" y="350" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1915" y="326" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1830" y="350" />
        <di:waypoint x="1882" y="350" />
        <di:waypoint x="1882" y="480" />
        <di:waypoint x="1935" y="480" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1862" y="456" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="2055" y="480" />
        <di:waypoint x="2167" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13">
        <di:waypoint x="2055" y="350" />
        <di:waypoint x="2090" y="350" />
        <di:waypoint x="2090" y="660" />
        <di:waypoint x="2125" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_14" bpmnElement="Flow_14">
        <di:waypoint x="2245" y="660" />
        <di:waypoint x="2280" y="660" />
        <di:waypoint x="2280" y="350" />
        <di:waypoint x="2315" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_15" bpmnElement="Flow_15">
        <di:waypoint x="2435" y="350" />
