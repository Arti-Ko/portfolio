        <di:waypoint x="2815" y="840" />
        <di:waypoint x="2850" y="840" />
        <di:waypoint x="2850" y="350" />
        <di:waypoint x="2885" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_18" bpmnElement="Flow_18">
        <di:waypoint x="3005" y="350" />
        <di:waypoint x="3061" y="350" />
        <di:waypoint x="3061" y="170" />
        <di:waypoint x="3117" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
