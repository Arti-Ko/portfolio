<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_event_reminders"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="sa-portfolio/tools/bpmn_gen.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_event_reminders">
    <bpmn:participant id="Participant_event_reminders" name="Напоминания за 24 ч и 1 ч до события" processRef="Process_event_reminders" />
  </bpmn:collaboration>
  <bpmn:process id="Process_event_reminders" name="Автоматические напоминания о мероприятии" isExecutable="false">
    <bpmn:documentation>Планировщик раз в час отбирает подтверждённые заявки, попадающие в окно напоминания, и рассылает сообщения с кнопками подтверждения. Отказ освобождает место и запускает добор из листа ожидания.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_event_reminders">
      <bpmn:lane id="Lane_sched" name="Планировщик">
        <bpmn:flowNodeRef>Start_tick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_any</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_empty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_queue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_released</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bot" name="Telegram-бот">
        <bpmn:flowNodeRef>T_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_decline</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_participant" name="Участник">
        <bpmn:flowNodeRef>T_answer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Start_tick" name="Ежечасный запуск
по расписанию">
        <bpmn:outgoing>Flow_01</bpmn:outgoing>
        <bpmn:timerEventDefinition />
      </bpmn:startEvent>
      <bpmn:serviceTask id="T_select" name="Отобрать заявки в окне
T-24 ч и T-1 ч">
        <bpmn:incoming>Flow_01</bpmn:incoming>
        <bpmn:outgoing>Flow_02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_any" name="Есть адресаты?">
        <bpmn:incoming>Flow_02</bpmn:incoming>
        <bpmn:outgoing>Flow_03</bpmn:outgoing>
        <bpmn:outgoing>Flow_04</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_empty" name="Рассылка не требуется">
        <bpmn:incoming>Flow_04</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="T_queue" name="Сформировать очередь
с учётом лимитов Telegram">
        <bpmn:incoming>Flow_03</bpmn:incoming>
        <bpmn:outgoing>Flow_05</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="T_send" name="Отправить напоминание
с кнопками «Буду» / «Не приду»">
        <bpmn:incoming>Flow_05</bpmn:incoming>
        <bpmn:outgoing>Flow_06</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="T_answer" name="Ответить на напоминание">
        <bpmn:incoming>Flow_06</bpmn:incoming>
        <bpmn:outgoing>Flow_07</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G_decline" name="Участник отказался?">
        <bpmn:incoming>Flow_07</bpmn:incoming>
        <bpmn:outgoing>Flow_08</bpmn:outgoing>
        <bpmn:outgoing>Flow_09</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T_release" name="Освободить место и пригласить
первого из листа ожидания">
        <bpmn:incoming>Flow_08</bpmn:incoming>
        <bpmn:outgoing>Flow_10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="T_confirm" name="Проставить статус
«подтвердил» в CRM">
        <bpmn:incoming>Flow_09</bpmn:incoming>
        <bpmn:outgoing>Flow_11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_released" name="Место переиспользовано">
        <bpmn:incoming>Flow_10</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_confirmed" name="Участие подтверждено">
        <bpmn:incoming>Flow_11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_tick" targetRef="T_select" />
      <bpmn:sequenceFlow id="Flow_02" sourceRef="T_select" targetRef="G_any" />
      <bpmn:sequenceFlow id="Flow_03" name="да" sourceRef="G_any" targetRef="T_queue" />
      <bpmn:sequenceFlow id="Flow_04" name="нет" sourceRef="G_any" targetRef="End_empty" />
      <bpmn:sequenceFlow id="Flow_05" sourceRef="T_queue" targetRef="T_send" />
      <bpmn:sequenceFlow id="Flow_06" sourceRef="T_send" targetRef="T_answer" />
      <bpmn:sequenceFlow id="Flow_07" sourceRef="T_answer" targetRef="G_decline" />
      <bpmn:sequenceFlow id="Flow_08" name="да" sourceRef="G_decline" targetRef="T_release" />
      <bpmn:sequenceFlow id="Flow_09" name="нет" sourceRef="G_decline" targetRef="T_confirm" />
      <bpmn:sequenceFlow id="Flow_10" sourceRef="T_release" targetRef="End_released" />
      <bpmn:sequenceFlow id="Flow_11" sourceRef="T_confirm" targetRef="End_confirmed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_event_reminders">
    <bpmndi:BPMNPlane id="Plane_event_reminders" bpmnElement="Collaboration_event_reminders">
      <bpmndi:BPMNShape id="Shape_Participant_event_reminders" bpmnElement="Participant_event_reminders" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1780" height="670" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_sched" bpmnElement="Lane_sched" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1750" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_bot" bpmnElement="Lane_bot" isHorizontal="true">
        <dc:Bounds x="190" y="390" width="1750" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_participant" bpmnElement="Lane_participant" isHorizontal="true">
        <dc:Bounds x="190" y="570" width="1750" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_tick" bpmnElement="Start_tick">
        <dc:Bounds x="267" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="232" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_select" bpmnElement="T_select">
        <dc:Bounds x="415" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_any" bpmnElement="G_any">
        <dc:Bounds x="640" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="605" y="201" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_empty" bpmnElement="End_empty">
        <dc:Bounds x="837" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="802" y="324" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_queue" bpmnElement="T_queue">
        <dc:Bounds x="795" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_send" bpmnElement="T_send">
        <dc:Bounds x="985" y="440" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_answer" bpmnElement="T_answer">
        <dc:Bounds x="1175" y="620" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_G_decline" bpmnElement="G_decline">
        <dc:Bounds x="1400" y="455" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1365" y="511" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_release" bpmnElement="T_release">
        <dc:Bounds x="1555" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_confirm" bpmnElement="T_confirm">
        <dc:Bounds x="1555" y="260" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_released" bpmnElement="End_released">
        <dc:Bounds x="1787" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1752" y="194" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_confirmed" bpmnElement="End_confirmed">
        <dc:Bounds x="1787" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1752" y="324" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="303" y="170" />
        <di:waypoint x="415" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="535" y="170" />
        <di:waypoint x="640" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03">
        <di:waypoint x="690" y="170" />
        <di:waypoint x="795" y="170" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="775" y="146" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04">
        <di:waypoint x="690" y="170" />
        <di:waypoint x="763" y="170" />
        <di:waypoint x="763" y="300" />
        <di:waypoint x="837" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="743" y="276" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="915" y="170" />
        <di:waypoint x="950" y="170" />
        <di:waypoint x="950" y="480" />
        <di:waypoint x="985" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="1105" y="480" />
        <di:waypoint x="1140" y="480" />
        <di:waypoint x="1140" y="660" />
        <di:waypoint x="1175" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07" bpmnElement="Flow_07">
        <di:waypoint x="1295" y="660" />
        <di:waypoint x="1347" y="660" />
        <di:waypoint x="1347" y="480" />
        <di:waypoint x="1400" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08">
        <di:waypoint x="1450" y="480" />
        <di:waypoint x="1502" y="480" />
        <di:waypoint x="1502" y="170" />
        <di:waypoint x="1555" y="170" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1482" y="146" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09" bpmnElement="Flow_09">
        <di:waypoint x="1450" y="480" />
        <di:waypoint x="1502" y="480" />
        <di:waypoint x="1502" y="300" />
        <di:waypoint x="1555" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1482" y="276" width="90" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1675" y="170" />
        <di:waypoint x="1787" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1675" y="300" />
        <di:waypoint x="1787" y="300" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
